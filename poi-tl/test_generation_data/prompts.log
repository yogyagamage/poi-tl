        addPart = addPart.replaceAll(("r:id=\"" + relaId) + "\"", ("r:id=\"" + hyperlinkMap.get(relaId)) + "\"");
    }
    // chart id
    for (String relaId : chartIdsMap.keySet()) {
        chartIdsMap.put(relaId, chartIdsMap.get(relaId) + CROSS_REPLACE_STRING);
    }
    for (String relaId : chartIdsMap.keySet()) {
