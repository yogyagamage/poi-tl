 * @return  */
public static XWPFTemplate compile(XWPFDocument document, Configure config) {
    try {
        return compile(PoitlIOUtils.docToInputStream(document), config);
    } catch (IOException e) {
        throw new ResolverException("Cannot compile document", e);
    }
}

