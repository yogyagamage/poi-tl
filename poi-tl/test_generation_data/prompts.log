    } else if (compute instanceof Iterable) // PATH: Test should invoke the next IterableProcessor.handleIterable(...) [step in execution path]
    {
        handleIterable(iterableTemplate, bodyContainer, ((Iterable<?>) (compute)));
        afterHandle(iterableTemplate, bodyContainer, false);
    } else {
        if ((compute instanceof Boolean) && ((Boolean) (compute))) {
            handleOnceWithScope(iterableTemplate, renderDataCompute);
        } else {
            handleOnce(iterableTemplate, compute);
        }
        afterHandle(iterableTemplate, bodyContainer, false);
    }
}

@Override
protected void handleIterable(IterableTemplate iterableTemplate, BodyContainer bodyContainer, Iterable<?> compute) {
    CTP startCtp = ((XWPFParagraph) (iterableTemplate.getStartRun().getParent())).getCTP();
    CTP endCtp = ((XWPFParagraph) (iterableTemplate.getEndRun().getParent())).getCTP();
    int startPos = bodyContainer.getPosOfParagraphCTP(startCtp);
    int endPos = bodyContainer.getPosOfParagraphCTP(endCtp);
    NumberingContinue numbringContinue = NumberingContinue.of(bodyContainer, startPos, endPos, iterableTemplate);
    IterableContext context = new IterableContext(startPos, endPos, numbringContinue);
    EnvIterator.foreach(compute.iterator(), model -> next(iterableTemplate, bodyContainer, context, model));
    // clear self iterable template
    for (int i = endPos - 1; i > startPos; i--) // PATH: Test should invoke the next SDTBodyContainer.removeBodyElement(...) [step in execution path]
    {
        bodyContainer.removeBodyElement(i);
    }
}

@Override
public void removeBodyElement(int pos) {
    List<IBodyElement> bodyElements = getBodyElements();
    if ((pos >= 0) && (pos < bodyElements.size())) {
        BodyElementType type = bodyElements.get(pos).getElementType();
        if (type == BodyElementType.TABLE) {
            // TODO remove table
        }
        if (type == BodyElementType.PARAGRAPH) // PATH: Test should invoke the next XWPFStructuredDocumentTagContent.removeParagraph(...) [step in execution path]
        {
