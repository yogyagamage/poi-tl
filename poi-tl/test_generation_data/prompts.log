public static List<XDDFChartData> getChartSeries(XWPFChart chart) {
    List<XDDFChartData> series = new LinkedList<>();
    List<XDDFChartData> chartSeries = chart.getChartSeries();
    series.addAll(chartSeries);
    CTPlotArea plotArea = chart.getCTChart().getPlotArea();
    for (int i = 0; i < plotArea.sizeOfOfPieChartArray(); i++) {
        CTOfPieChart barChart = plotArea.getOfPieChartArray(i);
        series.add(new XDDFOfPieChartData(chart, barChart));
    }
    return series;
}

public XDDFOfPieChartData(XDDFChart parent, CTOfPieChart chart) {
    super(parent);
    this.chart = chart;
    this.seriesNum = parent.getChartSeries().size();
    for (CTPieSer series : chart.getSerList()) {
        this.series.add(new Series(series, series.getCat(), series.getVal()));
    }
}

protected (CTPieSer series, XDDFDataSource<?> category, XDDFNumericalDataSource<? extends Number> values) // PATH: Test should invoke the next new XDDFChartData$Series(...) [step in execution path]
{
    this(category, values);
    this.series = series;
}
