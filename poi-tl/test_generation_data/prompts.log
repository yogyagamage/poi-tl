}

public static void styleCTBorder(CTBorder b, BorderStyle style) // PATH: Test should invoke the next CTBorder.setSpace(...) [step in execution path]
{
    if (null != style.getType()) {
        b.setVal(STBorder.Enum.forString(style.getType().toString().toLowerCase()));
    }
    b.setSz(BigInteger.valueOf(style.getSize()));
    b.setSpace(BigInteger.valueOf(style.getSpace()));
    if (null != style.getColor()) {
        b.setColor(style.getColor());
    }
}
