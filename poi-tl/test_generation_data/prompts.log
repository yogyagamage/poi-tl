public static void styleParagraph(XWPFParagraph paragraph, ParagraphStyle style) // PATH: Test should invoke the next StyleUtils.styleParaRpr(...) [step in execution path]
{
    if ((null == paragraph) || (null == style)) {
        return;
    }
