        if (null != tcPr) {
            CTDecimalNumber gridSpan = tcPr.getGridSpan();
            if (null != gridSpan) {
                intValue = gridSpan.getVal().intValue();
            }
        }
        orginalCol += intValue;
        if (((orginalCol - intValue) == insertPosition) && (intValue == 1)) {
            return i;
        }
    }
    return -1;
}
