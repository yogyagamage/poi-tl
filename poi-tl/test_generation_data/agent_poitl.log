    private TableRenderData createTableRenderDataWithUnderline() {
        // Create style with underline
        Style underlineStyle = Style.builder()
                .buildUnderline(UnderlinePatterns.SINGLE)
                .buildUnderlineColor("FF0000")
                .buildFontFamily("Arial")
                .buildFontSize(12)
                .buildBold()
                .buildItalic()
                .buildColor("000000")
                .buildStrike(false)
                .build();
        
        // Create ParagraphStyle with the underline style
        ParagraphStyle paragraphStyle = ParagraphStyle.builder()
                .withGlyphStyle(underlineStyle)
                .build();
        
        // Create TextRenderData
        TextRenderData textData = new TextRenderData("Test text");
        
        // Create ParagraphRenderData
        ParagraphRenderData paragraphData = ParagraphRenderData.builder()
                .addText(textData)
                .withParagraphStyle(paragraphStyle)
                .build();
        
        // Create CellRenderData
        CellRenderData cellData = CellRenderData.builder()
                .addParagraph(paragraphData)
                .build();
        
        // Create RowRenderData
        RowRenderData rowData = RowRenderData.builder()
                .addCell(cellData)
                .build();
        
        // Create TableRenderData
        TableRenderData tableData = TableRenderData.builder()
                .addRow(rowData)
                .build();
        
        return tableData;
    }
}

