    @Test
    public void testRetriveParagraphStyleInvokesCTPBdrIsSetBottom() throws Exception {
        // Create real paragraph object
        XWPFParagraph paragraph = Mockito.mock(XWPFParagraph.class);
        
        // Create real CTP object
        CTP ctp = Mockito.mock(CTP.class);
        when(paragraph.getCTP()).thenReturn(ctp);
        
        // Create real CTPPr object
        CTPPr pr = Mockito.mock(CTPPr.class);
        when(ctp.isSetPPr()).thenReturn(true);
        when(ctp.getPPr()).thenReturn(pr);
        
        // Create real CTPBdr object that will have isSetBottom() called
        CTPBdr ct = Mockito.mock(CTPBdr.class);
        when(pr.isSetPBdr()).thenReturn(true);
        when(pr.getPBdr()).thenReturn(ct);
        
        // Configure CTPBdr to have bottom border set (so isSetBottom() returns true)
        when(ct.isSetBottom()).thenReturn(true);
        
        // Create real CTBorder for bottom border
        CTBorder bottomBorder = Mockito.mock(CTBorder.class);
        when(ct.getBottom()).thenReturn(bottomBorder);
        
        // Configure other required border checks to return false to avoid NPE
        when(ct.isSetLeft()).thenReturn(false);
        when(ct.isSetTop()).thenReturn(false);
        when(ct.isSetRight()).thenReturn(false);
        
        // Configure shading
        CTShd shd = Mockito.mock(CTShd.class);
        when(pr.isSetShd()).thenReturn(true);
        when(pr.getShd()).thenReturn(shd);
        when(shd.getVal()).thenReturn(STShd.CLEAR);
        
        // Configure paragraph properties
        when(paragraph.isWordWrapped()).thenReturn(false);
        when(paragraph.getAlignment()).thenReturn(ParagraphAlignment.LEFT);
        when(paragraph.getSpacingBeforeLines()).thenReturn(-1);
        when(paragraph.getSpacingAfterLines()).thenReturn(-1);
        when(paragraph.getSpacingBefore()).thenReturn(-1);
        when(paragraph.getSpacingAfter()).thenReturn(-1);
        when(paragraph.getSpacingBetween()).thenReturn(-1.0);
        
        // Execute the method - this will invoke ct.isSetBottom()
        StyleUtils.retriveParagraphStyle(paragraph);
    }
}

