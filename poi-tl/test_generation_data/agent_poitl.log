import org.apache.poi.xwpf.usermodel.XWPFAbstractNum;
import org.apache.poi.xwpf.usermodel.XWPFNum;
import org.apache.poi.xwpf.usermodel.XWPFNumbering;
import com.deepoove.poi.xwpf.NiceXWPFDocument;
import com.deepoove.poi.xwpf.XmlXWPFDocumentMerge;
import com.deepoove.poi.xwpf.XWPFNumberingWrapper;

public class XmlXWPFDocumentMergemergeNumbering_CTAbstractNumsetAbstractNumIdFikaTest {

    @Test
    public void testMergeNumbering() throws Exception {
        XmlXWPFDocumentMerge merger = new XmlXWPFDocumentMerge();
        
        NiceXWPFDocument sourceDoc = Mockito.mock(NiceXWPFDocument.class);
        NiceXWPFDocument mergedDoc = Mockito.mock(NiceXWPFDocument.class);
        
        XWPFNumbering sourceNumbering = Mockito.mock(XWPFNumbering.class);
        XWPFNumbering mergedNumbering = Mockito.mock(XWPFNumbering.class);
        
        XWPFNumberingWrapper sourceWrapper = Mockito.mock(XWPFNumberingWrapper.class);
        XWPFNumberingWrapper mergedWrapper = Mockito.mock(XWPFNumberingWrapper.class);
        
        XWPFNum mockNum = Mockito.mock(XWPFNum.class);
        CTNum mockCTNum = Mockito.mock(CTNum.class);
        XWPFAbstractNum mockAbstractNum = Mockito.mock(XWPFAbstractNum.class);
        CTAbstractNum mockCTAbstractNum = Mockito.mock(CTAbstractNum.class);
        
        Mockito.when(mergedDoc.getNumbering()).thenReturn(mergedNumbering);
        Mockito.when(sourceDoc.getNumbering()).thenReturn(null);
        Mockito.when(sourceDoc.createNumbering()).thenReturn(sourceNumbering);
        
        Mockito.when(mergedWrapper.getNums()).thenReturn(java.util.Arrays.asList(mockNum));
        
        Mockito.when(mockNum.getCTNum()).thenReturn(mockCTNum);
        Mockito.when(mockCTNum.getNumId()).thenReturn(BigInteger.valueOf(1));
        Mockito.when(mockCTNum.getAbstractNumId()).thenReturn(Mockito.mock(org.openxmlformats.schemas.wordprocessingml.x2006.main.CTDecimalNumber.class));
        Mockito.when(mockCTNum.getAbstractNumId().getVal()).thenReturn(BigInteger.valueOf(100));
        
        Mockito.when(mergedNumbering.getAbstractNum(BigInteger.valueOf(100))).thenReturn(mockAbstractNum);
        Mockito.when(mockAbstractNum.getCTAbstractNum()).thenReturn(mockCTAbstractNum);
        
        Mockito.when(sourceWrapper.getNextAbstractNumID()).thenReturn(BigInteger.valueOf(500));
        
        Mockito.when(sourceNumbering.addAbstractNum(Mockito.any(XWPFAbstractNum.class))).thenReturn(BigInteger.valueOf(600));
        Mockito.when(sourceNumbering.addNum(BigInteger.valueOf(600))).thenReturn(BigInteger.valueOf(700));
        
        merger.mergeNumbering(sourceDoc, mergedDoc);
    }
}

