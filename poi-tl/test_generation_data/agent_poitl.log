    public void testGetText() throws Exception {
        // Create a real XWPFSDT object
        XWPFDocument document = new XWPFDocument();
        XWPFSDT sdt = document.createSDT();
        
        // Create a real ISDTContent implementation
        ISDTContent content = new SimpleISDTContent();
        
        // Set up the sdtElements list with an XWPFSDT that has content
        List<Object> sdtElements = new ArrayList<>();
        XWPFSDT nestedSdt = document.createSDT();
        nestedSdt.setContent(content);
