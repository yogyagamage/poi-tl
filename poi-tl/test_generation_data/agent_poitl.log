import org.junit.jupiter.api.Test;
import org.openxmlformats.schemas.wordprocessingml.x2006.main.CTRow;

import java.util.ArrayList;
import java.util.List;

public class TableToolsmergeCellsHorizonal_CTRowremoveTcFikaTest {

    @Test
    public void testMergeCellsHorizonalInvokesCTRowRemoveTc() throws Exception {
        // Create a real XWPFTable with minimal structure
        XWPFTable table = new XWPFTable(null, null) {
            private final List<XWPFTableRow> rows = new ArrayList<>();
            
            @Override
            public XWPFTableRow getRow(int row) {
                return rows.get(row);
            }
            
            @Override
            public int getNumberOfRows() {
                return rows.size();
            }
            
            public void addRow(XWPFTableRow row) {
                rows.add(row);
            }
        };
        
        // Create a row with enough cells to trigger the removeTc call
        XWPFTableRow row = new XWPFTableRow(null, null) {
            private final List<XWPFTableCell> cells = new ArrayList<>();
            private final CTRow ctRow = CTRow.Factory.newInstance();
            
            @Override
            public List<XWPFTableCell> getTableCells() {
                return cells;
            }
            
            @Override
            public CTRow getCtRow() {
                return ctRow;
            }
            
            @Override
            public XWPFTableCell removeCell(int pos) {
                if (pos >= 0 && pos < cells.size()) {
                    cells.remove(pos);
                }
                return null;
            }
            
            public void addCell(XWPFTableCell cell) {
                cells.add(cell);
                // Add corresponding tc to ctRow to match initial size
                ctRow.addNewTc();
            }
        };
        
        // Add 4 cells to the row (fromCol=0, toCol=3 requires at least 4 cells)
        for (int i = 0; i < 4; i++) {
            row.addCell(new XWPFTableCell(null, null));
        }
        
        // Add the row to the table
        table.addRow(row);
        
        // Call the entry point method - this should trigger removeTc when fromCol+1 < cells.size()
        TableTools.mergeCellsHorizonal(table, 0, 0, 3);
    }
}

