        addParts.add(createMergeableString(source, next, mergeStyles));
        try {
            next.close();
        } catch (Exception e) {
            logger.warn("close merged doc failed!", e);
        }
        if (iterator.hasNext()) {
            next = iterator.next();
        } else {
            break;
        }
    } while (true );
    return addParts;
}

