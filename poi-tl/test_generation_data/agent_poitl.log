public class SingleSeriesChartTemplateRenderPolicy_AbstractChartTemplateRenderPolicycreateStringDataSource_CellRangeAddressmethodFikaTest {

    @Test
    public void testCreateStringDataSource() throws Exception {
        XWPFChart chart = Mockito.mock(XWPFChart.class);
        String[] categories = new String[]{"Category1", "Category2", "Category3"};
        int col = 0;
        
        Mockito.when(chart.formatRange(Mockito.any(CellRangeAddress.class))).thenReturn("Sheet1!$A$1:$A$3");
        
        TestablePolicy policy = new TestablePolicy();
        policy.createStringDataSource(chart, categories, col);
    }
    
    private static class TestablePolicy {
        protected XDDFDataSource<?> createStringDataSource(XWPFChart chart, String[] categories, int col) {
