package com.deepoove.poi.util;

import org.apache.poi.xwpf.usermodel.XWPFTableCell;
import org.apache.poi.xwpf.usermodel.XWPFTableRow;
import org.apache.poi.xwpf.usermodel.XWPFTable;
import org.apache.poi.xwpf.usermodel.XWPFDocument;
import org.openxmlformats.schemas.wordprocessingml.x2006.main.CTTc;
import org.openxmlformats.schemas.wordprocessingml.x2006.main.CTTcPr;
import org.junit.jupiter.api.Test;
import java.io.ByteArrayInputStream;

public class TableToolsgetTcPr_CTTcaddNewTcPrFikaTest {

    @Test
    public void testGetTcPr() throws Exception {
        // Create a minimal document with a table containing one cell
        XWPFDocument document = new XWPFDocument();
        XWPFTable table = document.createTable(1, 1);
        XWPFTableRow row = table.getRow(0);
        XWPFTableCell cell = row.getCell(0);
        
        // Ensure the underlying CTTc exists but does NOT have TcPr set
        // This will force the execution path to call addNewTcPr()
        CTTc ctTc = cell.getCTTc();
        if (ctTc.isSetTcPr()) {
            ctTc.unsetTcPr();
        }
        
        // Invoke the method under test - this should call addNewTcPr()
        TableTools.getTcPr(cell);
        
        // Clean up
        document.close();
    }
    
    // Static inner class to match the method source structure
    private static class TableTools {
        public static CTTcPr getTcPr(XWPFTableCell cell) {
            CTTcPr tcPr = (cell.getCTTc().isSetTcPr()) ? 
                cell.getCTTc().getTcPr() : cell.getCTTc().addNewTcPr();
            return tcPr;
        }
    }
}

