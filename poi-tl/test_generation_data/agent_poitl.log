    private XWPFTable createXWPFTable() throws Exception {
        // Use reflection to create XWPFTable instance
        Class<?> xwpfTableClass = Class.forName("org.apache.poi.xwpf.usermodel.XWPFTable");
        
        // Get the document constructor (XWPFTable requires XWPFDocument)
        Class<?> xwpfDocumentClass = Class.forName("org.apache.poi.xwpf.usermodel.XWPFDocument");
        Object document = xwpfDocumentClass.getDeclaredConstructor().newInstance();
        
        // Create table using constructor XWPFTable(XWPFDocument, CTTbl)
        Class<?> ctTblClass = Class.forName("org.openxmlformats.schemas.wordprocessingml.x2006.main.CTTbl");
        Object ctTbl = ctTblClass.getDeclaredConstructor().newInstance();
        
        // Get the CTTblPr and set up borders to ensure addNewLeft() is called
        Method getTblPrMethod = ctTblClass.getMethod("getTblPr");
        CTTblPr tblPr = (CTTblPr) getTblPrMethod.invoke(ctTbl);
        
        // Ensure tblBorders is null so borderTable will create it
        // This ensures the path goes through the if (!tblBorders.isSetLeft()) check
        Method getTblBordersMethod = CTTblPr.class.getMethod("getTblBorders");
        CTTblBorders tblBorders = (CTTblBorders) getTblBordersMethod.invoke(tblPr);
        
        // If tblBorders exists, remove it to ensure null
        if (tblBorders != null) {
            Method unsetTblBordersMethod = CTTblPr.class.getMethod("unsetTblBorders");
            unsetTblBordersMethod.invoke(tblPr);
        }
        
        // Create table instance
        return (XWPFTable) xwpfTableClass
            .getDeclaredConstructor(xwpfDocumentClass, ctTblClass)
            .newInstance(document, ctTbl);
    }
}

