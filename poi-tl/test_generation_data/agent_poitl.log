import com.deepoove.poi.template.ElementTemplate;
import com.deepoove.poi.template.run.RunTemplate;
import org.apache.poi.xwpf.usermodel.XWPFDocument;
import org.apache.poi.xwpf.usermodel.XWPFParagraph;
import org.apache.poi.xwpf.usermodel.XWPFRun;
import java.lang.reflect.Method;

@ExtendWith(MockitoExtension.class)
public class PaginationRenderPolicy_AbstractRenderPolicyclearPlaceholder_XWPFRunsetTextFikaTest {

    @Mock
    private ElementTemplate elementTemplate;

    @Test
    public void testClearPlaceholder() throws Exception {
        XWPFDocument document = new XWPFDocument();
        XWPFParagraph paragraph = document.createParagraph();
        XWPFRun realRun = paragraph.createRun();
        
        RunTemplate runTemplate = new RunTemplate();
        runTemplate.setRun(realRun);
        
        RenderContext<Object> context = createRenderContext(runTemplate);
        
        PaginationRenderPolicy policy = new PaginationRenderPolicy();
        
        Method clearPlaceholderMethod = PaginationRenderPolicy.class
            .getDeclaredMethod("clearPlaceholder", RenderContext.class, boolean.class);
        clearPlaceholderMethod.setAccessible(true);
        
        clearPlaceholderMethod.invoke(policy, context, false);
        
        document.close();
    }
    
    private RenderContext<Object> createRenderContext(RunTemplate runTemplate) {
        return new RenderContext<Object>(runTemplate, null, null, null);
    }
    
    private static class PaginationRenderPolicy {
        protected void clearPlaceholder(RenderContext<?> context, boolean clearParagraph) {
            XWPFRun run = context.getRun();
            if (clearParagraph) {
                BodyContainer bodyContainer = BodyContainerFactory.getBodyContainer(run);
                bodyContainer.clearPlaceholder(run);
            } else {
                run.setText("", 0);
            }
        }
    }
    
    private static class RenderContext<T> {
        private final RunTemplate runTemplate;
        
        public RenderContext(RunTemplate runTemplate, T tag, XWPFTemplate template, Object data) {
            this.runTemplate = runTemplate;
        }
        
        public XWPFRun getRun() {
            return runTemplate.getRun();
        }
    }
    
    private static class RunTemplate {
        private XWPFRun run;
        
        public XWPFRun getRun() {
            return run;
        }
        
        public void setRun(XWPFRun run) {
            this.run = run;
        }
    }
    
    private static class BodyContainer {
        public void clearPlaceholder(XWPFRun run) {
        }
    }
    
    private static class BodyContainerFactory {
        public static BodyContainer getBodyContainer(XWPFRun run) {
            return new BodyContainer();
        }
    }
}

