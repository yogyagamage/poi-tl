        XmlXWPFDocumentMerge mergeInstance = new XmlXWPFDocumentMerge();
        
        // Call entry point method
        mergeInstance.merge(source, iterator, run);
    }
    
    private byte[] getDocumentWithFootnotes() {
        String docXml = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" +
                "<w:document xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">" +
                "<w:body>" +
                "<w:p><w:r><w:t>Test</w:t></w:r></w:p>" +
                "<w:sectPr><w:pgSz w:w=\"12240\" w:h=\"15840\"/></w:sectPr>" +
                "</w:body>" +
                "<w:footnotes>" +
