    @Test
    public void testDoRender() throws Exception {
        // Create real chart data
        ChartSingleSeriesRenderData renderData = ChartSingleSeriesRenderData.builder()
                .categories(Arrays.asList("Cat1", "Cat2", "Cat3"))
                .chartTitle("Test Chart")
                .xAxisTitle("X Axis")
                .yAxisTitle("Y Axis")
                .seriesData(SeriesRenderData.builder("Series1")
