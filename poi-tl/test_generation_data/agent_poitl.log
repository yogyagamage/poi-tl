    private NiceXWPFDocument createMinimalDocument() throws Exception {
        // Create a document with minimal valid structure
        String minimalDoc = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" +
                "<w:document xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">" +
                "<w:body>" +
                "<w:p><w:r><w:t>Test</w:t></w:r></w:p>" +
                "</w:body>" +
                "</w:document>";
        
        ByteArrayInputStream input = new ByteArrayInputStream(minimalDoc.getBytes());
        return new NiceXWPFDocument(input);
    }
    
    private void setupExternalPictureRelationship(NiceXWPFDocument doc) throws Exception {
        // Use reflection to access package part and setup relationships
        // This is necessary to ensure getTargetURI() is called
        org.apache.poi.openxml4j.opc.OPCPackage pkg = doc.getPackage();
