        BorderStyle style = new BorderStyle();
        style.setType(BorderStyle.BorderType.SINGLE);
        style.setSize(4);
        style.setSpace(0);
        style.setColor("FF0000");
        
        StyleUtils.styleCTBorder(border, style);
    }
    
    private static class BorderStyle {
        enum BorderType { SINGLE }
        
        private BorderType type;
