package com.deepoove.poi.render.processor;

import org.apache.poi.xwpf.usermodel.XWPFDocument;
import org.apache.poi.xwpf.usermodel.XWPFParagraph;
import org.apache.poi.xwpf.usermodel.XWPFNumbering;
import org.apache.poi.xwpf.usermodel.XWPFAbstractNum;
import org.apache.poi.xwpf.usermodel.XWPFNum;
import org.openxmlformats.schemas.wordprocessingml.x2006.main.CTAbstractNum;
import org.openxmlformats.schemas.wordprocessingml.x2006.main.CTNum;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import java.math.BigInteger;
import java.util.HashMap;

public class NumberingContinueupdateNumbering_XWPFNumberingaddAbstractNumFikaTest {

    @Test
    public void testUpdateNumberingCallsAddAbstractNum() throws Exception {
        // Create real document
        XWPFDocument document = new XWPFDocument();
        
        // Create real numbering
        XWPFNumbering numbering = document.createNumbering();
        
        // Create real abstract num
        CTAbstractNum ctAbstractNum = CTAbstractNum.Factory.newInstance();
        ctAbstractNum.setAbstractNumId(BigInteger.valueOf(1));
        XWPFAbstractNum abstractNum = new XWPFAbstractNum(ctAbstractNum);
        
        // Create real num
        CTNum ctNum = CTNum.Factory.newInstance();
        ctNum.setAbstractNumId(ctNum.addNewAbstractNumId());
        ctNum.getAbstractNumId().setVal(BigInteger.valueOf(1));
        XWPFNum num = new XWPFNum(ctNum, numbering);
        
        // Setup numbering to return our num and abstract num
        // We need to use reflection to populate internal maps since methods are package-private
        java.lang.reflect.Field numMapField = XWPFNumbering.class.getDeclaredField("numMap");
        numMapField.setAccessible(true);
        HashMap<BigInteger, XWPFNum> numMap = new HashMap<>();
        numMap.put(BigInteger.ONE, num);
        numMapField.set(numbering, numMap);
        
        java.lang.reflect.Field abstractNumMapField = XWPFNumbering.class.getDeclaredField("abstractNumMap");
        abstractNumMapField.setAccessible(true);
        HashMap<BigInteger, XWPFAbstractNum> abstractNumMap = new HashMap<>();
        abstractNumMap.put(BigInteger.ONE, abstractNum);
        abstractNumMapField.set(numbering, abstractNumMap);
        
        // Create source paragraph
        XWPFParagraph sourceParagraph = document.createParagraph();
        
        // Use reflection to set numID on paragraph since there's no public setter
        java.lang.reflect.Field numIDField = XWPFParagraph.class.getDeclaredField("numID");
        numIDField.setAccessible(true);
        numIDField.set(sourceParagraph, BigInteger.ONE);
        
        // Create target paragraph
        XWPFParagraph targetParagraph = document.createParagraph();
        
        // Create instance of class under test
        NumberingContinue numberingContinue = new NumberingContinue();
        
        // Use reflection to set consistCache since it's private
        java.lang.reflect.Field consistCacheField = NumberingContinue.class.getDeclaredField("consistCache");
        consistCacheField.setAccessible(true);
        consistCacheField.set(numberingContinue, new HashMap<BigInteger, BigInteger>());
        
        // Call the entry point method
        numberingContinue.updateNumbering(sourceParagraph, targetParagraph);
    }
}

