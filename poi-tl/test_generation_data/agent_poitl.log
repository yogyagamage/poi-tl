import java.io.ByteArrayInputStream;
import java.io.ByteArrayOutputStream;

public class RunningRunBodyrefactorBody_XWPFRunaddBreakFikaTest {

    @Test
    public void testRefactorBodyInvokesAddBreak() throws Exception {
        // Create a minimal document with a paragraph and run
        XWPFDocument document = new XWPFDocument();
        XWPFParagraph paragraph = document.createParagraph();
        XWPFRun run = paragraph.createRun();
        run.setText("Test text");
        
        // Add a break to the run to trigger the path in refactorBody
        run.addBreak();
        
        // Save and reload to ensure the break is persisted in the underlying XML
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        document.write(baos);
        document.close();
        
        ByteArrayInputStream bais = new ByteArrayInputStream(baos.toByteArray());
        XWPFDocument reloadedDoc = new XWPFDocument(bais);
        
        // Access the paragraph and run to potentially trigger refactorBody
        // Note: We cannot directly call the private refactorBody method,
        // but creating a document with breaks may cause it to be called internally
        // during document processing operations
        XWPFParagraph reloadedParagraph = reloadedDoc.getParagraphArray(0);
        if (reloadedParagraph != null) {
            for (XWPFRun reloadedRun : reloadedParagraph.getRuns()) {
                // Access the run's properties which may trigger internal processing
                reloadedRun.getText(0);
            }
        }
        
        reloadedDoc.close();
    }
}

