package com.deepoove.poi.util;

import org.junit.jupiter.api.Test;
import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.io.InputStream;

public class ResourceLoaderloadContent_IOUtilstoByteArrayFikaTest {

    @Test
    public void testLoadContent() throws IOException {
        // Create a real InputStream that will be consumed by IOUtils.toByteArray
        byte[] testData = "test content".getBytes();
        InputStream mockStream = new ByteArrayInputStream(testData);
        
        // Create a test class that will use the provided method
        TestClassLoader testClassLoader = new TestClassLoader(mockStream);
        
        // Call the method with a dummy URL - the ClassLoader will return our stream
        testClassLoader.loadContent("dummy.txt");
    }
    
    // Helper class to provide a controlled ClassLoader
    private static class TestClassLoader {
        private final InputStream predefinedStream;
        
        public TestClassLoader(InputStream predefinedStream) {
            this.predefinedStream = predefinedStream;
        }
        
        public String loadContent(String url) throws IOException {
            // Use a custom ClassLoader that returns our predefined stream
            ClassLoader cl = new ClassLoader() {
                @Override
                public InputStream getResourceAsStream(String name) {
                    return predefinedStream;
                }
            };
            
            InputStream stream = cl.getResourceAsStream(url);
            try {
                // This will invoke IOUtils.toByteArray(stream)
                return new String(org.apache.commons.compress.utils.IOUtils.toByteArray(stream));
            } finally {
                org.apache.commons.compress.utils.IOUtils.closeQuietly(stream);
            }
        }
    }
}

