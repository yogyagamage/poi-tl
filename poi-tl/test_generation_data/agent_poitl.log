    public void testRenderChain() throws Exception {
        // Create a minimal DOCX document with a TOC field
        String docxContent = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" +
                "<w:document xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">" +
                "<w:body><w:p><w:r><w:t>{{toc}}</w:t></w:r></w:p></w:body></w:document>";
        InputStream templateStream = new ByteArrayInputStream(docxContent.getBytes());
        
        // Configure with TOC plugin
        Configure config = Configure.builder()
                .bind("toc", new com.deepoove.poi.plugin.toc.TOCRenderPolicy())
                .build();
        
        // Create template using compile method
        XWPFTemplate template = XWPFTemplate.compile(templateStream, config);
        
        // Create output stream
        OutputStream out = new ByteArrayOutputStream();
        
        // Execute the entry point method
        template.render(Collections.singletonMap("toc", "Table of Contents"), out);
        
        // Clean up
        template.close();
        out.close();
    }
