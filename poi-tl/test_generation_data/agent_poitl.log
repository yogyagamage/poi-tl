        tableData.add("Row1");
        tableData.add("Row2");
        
        // Create output stream
        OutputStream out = new ByteArrayOutputStream();
        
        // Invoke the entry point method
        template.render(tableData, out);
        
        // Clean up
        template.close();
        out.close();
    }
}

