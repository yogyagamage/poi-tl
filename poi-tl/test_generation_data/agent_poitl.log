    @Test
    public void testMergePathToFootnoteEndnoteIdManager() throws Exception {
        // Create source document with minimal content
        XWPFDocument sourceDoc = new XWPFDocument();
        XWPFParagraph paragraph = sourceDoc.createParagraph();
        XWPFRun run = paragraph.createRun();
        run.setText("Test");
        
        // Create merged document with endnotes to trigger the path
        XWPFDocument mergedDoc = new XWPFDocument();
        mergedDoc.createEndnotes().addEndnote(new XWPFEndnote(mergedDoc.createEndnotes().getCTFtnEdns().addNewEdn()));
        
        NiceXWPFDocument source = new NiceXWPFDocument(sourceDoc);
        NiceXWPFDocument merged = new NiceXWPFDocument(mergedDoc);
        
        // Create iterator with the merged document
        Iterator<NiceXWPFDocument> iterator = Arrays.asList(merged).iterator();
        
        // Create instance of class under test
        XmlXWPFDocumentMerge mergeInstance = new XmlXWPFDocumentMerge();
        
        // Execute the entry point method
        mergeInstance.merge(source, iterator, run);
        
        // Clean up
        source.close();
        merged.close();
    }
}

