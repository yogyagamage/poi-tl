        try {
            // Create a minimal XWPFDocument with a paragraph containing a DocxRenderPolicy tag
            NiceXWPFDocument doc = new NiceXWPFDocument();
            doc.createParagraph().createRun().setText("{{@docx}}");
            byte[] bytes = doc.getPackage().getBytes();
            doc.close();
            return bytes;
        } catch (IOException e) {
            throw new RuntimeException(e);
        }
    }
    
    private AttachmentRenderData createAttachmentRenderData() {
        return new AttachmentRenderData() {
            @Override
            public AttachmentType getFileType() {
                return AttachmentType.DOCX;
            }
            
            @Override
            public byte[] readAttachmentData() {
                return createMinimalDocxBytes();
            }
            
            @Override
            public PictureRenderData getIcon() {
                // Create a simple icon
                PictureStyle style = new PictureStyle();
                style.setWidth(64);
                style.setHeight(64);
                return Pictures.ofBase64("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==", 
                    com.deepoove.poi.data.PictureType.PNG)
                    .size(64, 64)
                    .create();
            }
            
            @Override
            public String getAttachment() {
                return "test.docx";
            }
        };
    }
