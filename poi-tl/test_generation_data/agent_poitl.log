package com.deepoove.poi.xwpf;

import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import java.math.BigInteger;
import java.util.*;
import org.apache.poi.xwpf.usermodel.*;
import org.openxmlformats.schemas.wordprocessingml.x2006.main.*;

class XmlXWPFDocumentMergemergeNumbering_CTAbstractNumisSetNsidFikaTest {

    @Test
    void testMergePathToIsSetNsid() throws Exception {
        // Create source document with numbering
        NiceXWPFDocument sourceDoc = new NiceXWPFDocument();
        XWPFNumbering sourceNumbering = sourceDoc.createNumbering();
        
        // Create merged document with numbering that has CTAbstractNum with nsid
        NiceXWPFDocument mergedDoc = new NiceXWPFDocument();
        XWPFNumbering mergedNumbering = mergedDoc.createNumbering();
        
        // Create CTAbstractNum with nsid set
        CTAbstractNum ctAbstractNum = CTAbstractNum.Factory.newInstance();
        CTLong ctLong = CTLong.Factory.newInstance();
        ctLong.setVal(BigInteger.valueOf(12345));
        ctAbstractNum.setNsid(ctLong);
        
        // Add abstract num to merged numbering
        XWPFAbstractNum abstractNum = new XWPFAbstractNum(ctAbstractNum);
        BigInteger abstractNumId = mergedNumbering.addAbstractNum(abstractNum);
        
        // Create XWPFNum referencing the abstract num
        XWPFNum xwpfNum = new XWPFNum(CTNum.Factory.newInstance(), mergedDoc, mergedNumbering);
        xwpfNum.getCTNum().setNumId(BigInteger.valueOf(1));
        xwpfNum.getCTNum().addNewAbstractNumId().setVal(abstractNumId);
        
        // Create iterator with merged document
        List<NiceXWPFDocument> docs = new ArrayList<>();
        docs.add(mergedDoc);
        Iterator<NiceXWPFDocument> iterator = docs.iterator();
        
        // Create run for merge method
        XWPFParagraph paragraph = sourceDoc.createParagraph();
        XWPFRun run = paragraph.createRun();
        
        // Create XmlXWPFDocumentMerge instance
        XmlXWPFDocumentMerge mergeInstance = new XmlXWPFDocumentMerge();
        
        // Execute the entry point method
        mergeInstance.merge(sourceDoc, iterator, run);
    }
}

