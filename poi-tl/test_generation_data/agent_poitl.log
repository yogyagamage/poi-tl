private static void applyMergeRule(XWPFTable table, MergeCellRule mergeRule) {
    if (null == mergeRule) {
        return;
    }
    byte[][] markRemovedCell = new byte[TableTools.obtainRowSize(table)][TableTools.obtainColumnSize(table)];
