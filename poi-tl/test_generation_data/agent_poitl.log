import com.deepoove.poi.policy.TableRenderPolicy;
import org.apache.poi.xwpf.usermodel.XWPFDocument;
import org.junit.jupiter.api.Test;

import java.io.ByteArrayInputStream;
import java.util.Arrays;
import java.util.HashMap;
import java.util.Map;

public class XWPFTemplate_StyleUtilsstylePpr_XWPFParagraphsetPageBreakFikaTest {

    @Test
    public void testInvokeSetPageBreak() throws Exception {
        // Create a minimal document with a table containing a cell with a paragraph
        XWPFDocument document = new XWPFDocument();
        document.createParagraph().createRun().setText("placeholder");

        // Configure the template to use TableRenderPolicy for a tag
        Configure config = Configure.builder()
                .bind("tableData", new TableRenderPolicy())
                .build();

        // Create a table render data that triggers paragraph with page break style
        TableRenderData tableData = TableRenderData.builder()
                .addRow(RowRenderData.builder()
                        .addCell(CellRenderData.builder()
                                .addParagraph(ParagraphRenderData.builder()
                                        .addText(TextRenderData.builder().build())
                                        .paragraphStyle(ParagraphStyle.builder()
                                                .pageBreakBefore(true)  // This will trigger setPageBreak(true)
                                                .build())
                                        .build())
                                .build())
                        .build())
                .build();

        // Create the data model
        Map<String, Object> model = new HashMap<>();
        model.put("tableData", tableData);

        // Compile template using static factory method from constructors
        XWPFTemplate template = XWPFTemplate.compile(document, config);

        // Execute the entry point: render() with the model
        template.render(model);
    }
}

