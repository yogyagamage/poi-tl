    // Only one shapetype is needed
    String shapeTypeXml = "";
    if (!haveShapeType) {
        haveShapeType = true;
        shapeTypeXml = SHAPE_TYPE_XML;
    }
    String uuidRandom = UUID.randomUUID().toString().replace("-", "") + ThreadLocalRandom.current().nextInt(1024);
