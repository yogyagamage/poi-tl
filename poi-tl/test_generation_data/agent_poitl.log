        ParagraphRenderData paragraphData = new ParagraphRenderData();
        paragraphData.setParagraphStyle(paragraphStyle);
        DocumentRenderData docData = new DocumentRenderData(Arrays.asList(paragraphData));

        // Render template with data
        ByteArrayOutputStream out = new ByteArrayOutputStream();
        template.render(Collections.singletonMap("var", docData), out);
        
        // Cleanup
        template.close();
        out.close();
    }
}

