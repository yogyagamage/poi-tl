public class XWPFTemplate_MultiSeriesChartTemplateRenderPolicydoRender_XDDFNumericalDataSourcesetFormatCodeFikaTest {

    @Test
    public void test() throws Exception {
        // Create a minimal XWPFDocument with a chart
        XWPFDocument document = new NiceXWPFDocument();
        XWPFParagraph paragraph = document.createParagraph();
        XWPFRun run = paragraph.createRun();
        
        // Create a chart
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        document.createChart(500, 400);
        document.write(baos);
        document.close();
        
        // Reopen the document to get the chart
        ByteArrayInputStream bais = new ByteArrayInputStream(baos.toByteArray());
        XWPFDocument docWithChart = new NiceXWPFDocument(bais);
        List<XWPFChart> charts = docWithChart.getCharts();
        
        if (charts.isEmpty()) {
            // Create a mock chart if no chart was created
            XWPFChart mockChart = Mockito.mock(XWPFChart.class);
            XDDFChartData mockChartData = Mockito.mock(XDDFChartData.class);
            XDDFChartData.Series mockSeries = Mockito.mock(XDDFChartData.Series.class);
            XDDFNumericalDataSource<?> mockDataSource = Mockito.mock(XDDFNumericalDataSource.class);
            
            Mockito.when(mockChart.getChartSeries()).thenReturn(Collections.singletonList(mockChartData));
            Mockito.when(mockChartData.getSeriesCount()).thenReturn(1);
            Mockito.when(mockChartData.getSeries(0)).thenReturn(mockSeries);
            Mockito.when(mockSeries.getValuesData()).thenReturn(mockDataSource);
            
            // Create a mock workbook and sheet
            XSSFWorkbook mockWorkbook = Mockito.mock(XSSFWorkbook.class);
            XSSFSheet mockSheet = Mockito.mock(XSSFSheet.class);
            Mockito.when(mockChart.getWorkbook()).thenReturn(mockWorkbook);
            Mockito.when(mockWorkbook.getSheetAt(0)).thenReturn(mockSheet);
            Mockito.when(mockWorkbook.getNumberOfSheets()).thenReturn(1);
            
            // Use reflection to add the mock chart to the document
            Field chartsField = XWPFDocument.class.getDeclaredField("charts");
            chartsField.setAccessible(true);
            List<XWPFChart> chartList = new ArrayList<>();
            chartList.add(mockChart);
            chartsField.set(docWithChart, chartList);
        }
        
        // Compile the template
        XWPFTemplate template = XWPFTemplate.compile(docWithChart, Configure.builder()
                .bind("chart", new MultiSeriesChartTemplateRenderPolicy())
                .build());
        
        // Create ChartMultiSeriesRenderData with at least one series
        ChartMultiSeriesRenderData chartData = ChartMultiSeriesRenderData.builder()
