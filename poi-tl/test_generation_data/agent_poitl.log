private XWPFTableCell getActualCell(XWPFTableRow tableRow, int insertPosition) {
    int orginalCol = 0;
    for (int i = 0; i < tableRow.getTableCells().size(); i++) {
        XWPFTableCell current = tableRow.getCell(i);
        int intValue = 1;
        CTTcPr tcPr = // PATH: Test should invoke the next XWPFTableCell.getCTTc(...) [step in execution path]
        current.getCTTc().getTcPr();
        if (null != tcPr) {
            CTDecimalNumber gridSpan = tcPr.getGridSpan();
            if (null != gridSpan) {
                intValue = gridSpan.getVal().intValue();
            }
        }
        orginalCol += intValue;
        if ((orginalCol - 1) >= insertPosition) {
            return current;
        }
    }
    return null;
}

