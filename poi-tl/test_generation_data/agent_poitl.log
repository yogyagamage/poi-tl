    @Test
    public void testRenderTriggersGetRelationById() throws Exception {
        // Create a minimal XWPFDocument with a chart relation
        XWPFDocument xwpfDocument = new XWPFDocument();
        
        // Add a paragraph with a run
        XWPFParagraph paragraph = xwpfDocument.createParagraph();
        XWPFRun run = paragraph.createRun();
        run.setText("Test");
        
        // Create a chart and add it to the document
        XWPFChart chart = xwpfDocument.createChart();
        CTChart ctChart = chart.getCTChart();
        
        // Create a CTDrawing that references the chart
        CTDrawing ctDrawing = CTDrawing.Factory.newInstance();
        org.openxmlformats.schemas.drawingml.x2006.wordprocessingDrawing.CTInline inline = 
            ctDrawing.addNewInline();
        org.openxmlformats.schemas.drawingml.x2006.wordprocessingDrawing.CTGraphicalObject graphicalObject = 
            inline.addNewGraphic();
        org.openxmlformats.schemas.drawingml.x2006.main.CTGraphicalObjectData graphicalObjectData = 
            graphicalObject.addNewGraphicData();
        
        // Create a chart reference
        org.openxmlformats.schemas.drawingml.x2006.chart.CTChartReference chartReference = 
            org.openxmlformats.schemas.drawingml.x2006.chart.CTChartReference.Factory.newInstance();
        String chartId = xwpfDocument.getRelationId(chart);
        chartReference.setId(chartId);
        graphicalObjectData.set(chartReference);
        
        // We need to set the drawing on the run - but XWPFRun doesn't expose a method to set CTDrawing.
        // Instead, we'll use NiceXWPFDocument which wraps the original document.
        NiceXWPFDocument niceDocument = new NiceXWPFDocument(xwpfDocument);
        
        // Create a template with a DOCX tag that will trigger DocxRenderPolicy
        Configure configure = Configure.builder()
            .bind("docx", new com.deepoove.poi.policy.DocxRenderPolicy())
            .build();
        
        // Create an empty template document with a DOCX tag
        XWPFDocument templateDoc = new XWPFDocument();
        XWPFParagraph templateParagraph = templateDoc.createParagraph();
        XWPFRun templateRun = templateParagraph.createRun();
        templateRun.setText("{{@docx}}");
        
        // Compile the template
        XWPFTemplate template = XWPFTemplate.compile(templateDoc, configure);
        
        // Create a DocxRenderData that contains our chart document
        DocxRenderData docxRenderData = DocxRenderData.builder()
            .addFile(niceDocument)
            .build();
        
        // Render with the data - this should trigger the full chain
        template.render(Collections.singletonMap("docx", docxRenderData));
        
        // Close resources
        template.close();
        xwpfDocument.close();
    }
}

