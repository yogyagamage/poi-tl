        XWPFRun run = paragraph.createRun();
        run.setText("{{var}}");

        // Add border to paragraph to ensure CTBorder.xgetColor() is called
        CTP ctp = paragraph.getCTP();
        CTPPr ppr = ctp.isSetPPr() ? ctp.getPPr() : ctp.addNewPPr();
        CTPBdr borders = ppr.isSetPBdr() ? ppr.getPBdr() : ppr.addNewPBdr();
        CTBorder leftBorder = borders.isSetLeft() ? borders.getLeft() : borders.addNewLeft();
        leftBorder.setVal(org.openxmlformats.schemas.wordprocessingml.x2006.main.STBorder.SINGLE);
        leftBorder.setSz(4);
        leftBorder.setColor("FF0000"); // This ensures xgetColor() returns a value

        // Save document to a temporary file
