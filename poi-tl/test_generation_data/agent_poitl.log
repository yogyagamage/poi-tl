public class XWPFStructuredDocumentTagContentremoveParagraph_CTSdtContentBlockremovePFikaTest {

    @Test
    public void testRemoveParagraph() throws Exception {
        CTSdtContentBlock sdtContentBlock = Mockito.mock(CTSdtContentBlock.class);
        
        List<Object> paragraphs = new ArrayList<>();
        paragraphs.add(new Object());
        
        List<Object> sdtElements = new ArrayList<>();
        sdtElements.add(new Object());
        
        XWPFStructuredDocumentTagContent content = new XWPFStructuredDocumentTagContent(
            sdtContentBlock, paragraphs, sdtElements);
        
        content.removeParagraph(0);
    }
    
    private static class XWPFStructuredDocumentTagContent {
        private final CTSdtContentBlock sdtContentBlock;
        private final List<Object> paragraphs;
        private final List<Object> sdtElements;
        
        public XWPFStructuredDocumentTagContent(
                CTSdtContentBlock sdtContentBlock,
                List<Object> paragraphs,
                List<Object> sdtElements) {
            this.sdtContentBlock = sdtContentBlock;
            this.paragraphs = paragraphs;
            this.sdtElements = sdtElements;
        }
        
        public void removeParagraph(int pos) {
            Object removedParagraph = paragraphs.get(pos);
            paragraphs.remove(pos);
            sdtContentBlock.removeP(pos);
            sdtElements.remove(removedParagraph);
        }
    }
}

