package com.deepoove.poi;

import com.deepoove.poi.config.Configure;
import com.deepoove.poi.data.DocumentRenderData;
import com.deepoove.poi.data.ParagraphRenderData;
import com.deepoove.poi.data.RenderData;
import com.deepoove.poi.data.style.ParagraphStyle;
import com.deepoove.poi.data.style.Style;
import com.deepoove.poi.policy.DocumentRenderPolicy;
import com.deepoove.poi.xwpf.NiceXWPFDocument;
import org.apache.poi.xwpf.usermodel.UnderlinePatterns;
import org.apache.poi.xwpf.usermodel.XWPFDocument;
import org.apache.poi.xwpf.usermodel.XWPFRun;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.util.Arrays;
import java.util.Collections;

public class XWPFTemplate_StyleUtilsstyleParaRpr_CTParaRPraddNewUFikaTest {

    @Test
    public void testRenderChainToAddNewU() throws IOException {
        // Create a minimal document with a template tag
        XWPFDocument document = new XWPFDocument();
        XWPFRun run = document.createParagraph().createRun();
        
        // Configure with DocumentRenderPolicy bound to the template tag
        Configure configure = Configure.builder()
                .bind("var", new DocumentRenderPolicy())
                .build();
        
        // Create template using compile method
        XWPFTemplate template = XWPFTemplate.compile(document, configure);
        
        // Create data that will trigger the style chain
        Style style = Style.builder()
                .buildUnderlinePatterns(UnderlinePatterns.SINGLE)
                .buildUnderlineColor("FF0000")
                .build();
        
        ParagraphStyle paragraphStyle = ParagraphStyle.builder()
                .buildGlyphStyle(style)
                .build();
        
        ParagraphRenderData paragraphData = new ParagraphRenderData();
        paragraphData.setParagraphStyle(paragraphStyle);
        
        DocumentRenderData documentData = new DocumentRenderData(
                Arrays.asList(new RenderData[]{paragraphData})
        );
        
        // Render with the data model
        template.render(Collections.singletonMap("var", documentData));
        
        // Clean up
        template.close();
        document.close();
    }
}

