import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import org.openxmlformats.schemas.wordprocessingml.x2006.main.CTBookmark;
import org.apache.poi.xwpf.usermodel.XWPFParagraph;
import org.apache.poi.xwpf.usermodel.XWPFRun;

public class HelpercreateBookmark_CTBookmarksetNameFikaTest {

    @Test
    public void testCreateBookmark() throws Exception {
        XWPFRun textRun = Mockito.mock(XWPFRun.class);
        XWPFParagraph paragraph = Mockito.mock(XWPFParagraph.class);
        
        Mockito.when(textRun.getParent()).thenReturn(paragraph);
        
        java.lang.reflect.Method method = getClass().getDeclaredMethod(
            "createBookmark", 
            XWPFRun.class, 
            String.class
        );
        method.setAccessible(true);
        
        method.invoke(null, textRun, "testBookmark");
    }
    
    private static void createBookmark(XWPFRun textRun, String name) {
        XWPFParagraphWrapper wapper = new XWPFParagraphWrapper(((XWPFParagraph) (textRun.getParent())));
        CTBookmark bookmarkStart = wapper.insertNewBookmark(textRun);
        bookmarkStart.setName(name);
    }
    
    private static class XWPFParagraphWrapper {
        private final XWPFParagraph paragraph;
        
        public XWPFParagraphWrapper(XWPFParagraph paragraph) {
            this.paragraph = paragraph;
        }
        
        public CTBookmark insertNewBookmark(XWPFRun textRun) {
            return Mockito.mock(CTBookmark.class);
        }
    }
}

