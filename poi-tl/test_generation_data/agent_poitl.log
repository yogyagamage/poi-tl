public void doRender(RenderContext<Object> context) throws Exception // PATH: Test should invoke the next XWPFRun.setText(...) [step in execution path]
{
    RunTemplate runTemplate = ((RunTemplate) (context.getEleTemplate()));
    XWPFRun run = runTemplate.getRun();
    run.setText("", 0);
    try {
        if (!TableTools.isInsideTable(run)) {
            throw new IllegalStateException(("The template tag " + runTemplate.getSource()) + " must be inside a table");
        }
        XWPFTableCell cell = ((XWPFTableCell) (((XWPFParagraph) (run.getParent())).getBody()));
        XWPFTable table = cell.getTableRow().getTable();
        render(table, context.getData());
    } catch (Exception e) {
        throw new RenderException("Dynamic render table error:" + e.getMessage(), e);
    }
}

