        // Create mock XWPFTableCell
        XWPFTableCell mockCell = Mockito.mock(XWPFTableCell.class);
        XWPFParagraph mockParagraph = Mockito.mock(XWPFParagraph.class);
        XWPFRun mockRun = Mockito.mock(XWPFRun.class);
        
        // Setup mock behavior to traverse the path
        Mockito.when(mockCell.getParagraphArray(0)).thenReturn(mockParagraph);
        Mockito.when(mockParagraph.getCTP()).thenReturn(Mockito.mock(org.openxmlformats.schemas.wordprocessingml.x2006.main.CTP.class));
        Mockito.when(mockParagraph.createRun()).thenReturn(mockRun);
        Mockito.when(mockRun.getParent()).thenReturn(mockParagraph);
        
        // Create CellRenderData with ParagraphRenderData
