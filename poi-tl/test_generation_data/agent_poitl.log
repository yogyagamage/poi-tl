        // Create series data - more series than originally in chart to trigger addSeries
        List<SeriesRenderData> seriesList = new ArrayList<>();
        
        // First series
        SeriesRenderData series1 = new SeriesRenderData();
        series1.setName("Series1");
        series1.setValues(new Double[]{1.0, 2.0, 3.0});
