package com.deepoove.poi.xwpf;

import org.junit.jupiter.api.Test;
import org.apache.poi.xwpf.usermodel.XWPFParagraph;
import org.apache.poi.xwpf.usermodel.XWPFRun;
import org.openxmlformats.schemas.wordprocessingml.x2006.main.CTP;
import org.openxmlformats.schemas.wordprocessingml.x2006.main.CTBody;
import java.util.Iterator;
import java.util.Collections;
import java.io.ByteArrayInputStream;
import java.io.IOException;

public class XmlXWPFDocumentMergemergeNumbering_CTAbstractNumunsetTmplFikaTest {

    @Test
    public void testMergePath() throws Exception {
        // Create source document with minimal content to trigger numbering merge
        NiceXWPFDocument sourceDoc = new NiceXWPFDocument();
        
        // Create a merged document with numbering to trigger mergeNumbering
        byte[] mergedDocBytes = createDocumentWithNumbering();
        NiceXWPFDocument mergedDoc = new NiceXWPFDocument(new ByteArrayInputStream(mergedDocBytes));
        
        // Create iterator with the merged document
        Iterator<NiceXWPFDocument> mergeIterator = Collections.singletonList(mergedDoc).iterator();
        
        // Create a run in the source document
        XWPFParagraph paragraph = sourceDoc.createParagraph();
        XWPFRun run = paragraph.createRun();
        run.setText("placeholder");
        
        // Instantiate the class under test
        XmlXWPFDocumentMerge merger = new XmlXWPFDocumentMerge();
        
        // Execute the entry point method - this should traverse the entire path
        merger.merge(sourceDoc, mergeIterator, run);
        
        // Clean up
        sourceDoc.close();
        mergedDoc.close();
    }
    
    private byte[] createDocumentWithNumbering() throws IOException {
        // Create a minimal document with numbering that has Tmpl set
        NiceXWPFDocument doc = new NiceXWPFDocument();
        
        // Create numbering in the document
        doc.createNumbering();
        
        // Create a paragraph with numbering
        XWPFParagraph paragraph = doc.createParagraph();
        paragraph.setNumID(BigInteger.ONE);
        
        // Convert to bytes
        java.io.ByteArrayOutputStream baos = new java.io.ByteArrayOutputStream();
        doc.write(baos);
        byte[] bytes = baos.toByteArray();
        doc.close();
        
        return bytes;
    }
}

