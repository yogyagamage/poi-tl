        // Create a real XWPFDocument
        XWPFDocument document = new XWPFDocument();
        
        // Create a real CTTbl using XML beans
        String xml = "<w:tbl xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">" +
