package com.deepoove.poi.policy;

import com.deepoove.poi.data.NumberingItemRenderData;
import com.deepoove.poi.data.NumberingRenderData;
import com.deepoove.poi.data.NumberingFormat;
import com.deepoove.poi.util.BodyContainer;
import com.deepoove.poi.util.BodyContainerFactory;
import com.deepoove.poi.util.StyleUtils;
import com.deepoove.poi.xwpf.NiceXWPFDocument;
import org.apache.poi.xwpf.usermodel.XWPFParagraph;
import org.apache.poi.xwpf.usermodel.XWPFRun;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.math.BigInteger;
import java.util.Arrays;
import java.util.List;

public class HelperrenderNumbering_XWPFParagraphsetNumIDFikaTest {

    @Test
    public void testRenderNumbering() throws Exception {
        // Create a real NumberingRenderData with items that will trigger setNumID
        NumberingItemRenderData item = new NumberingItemRenderData();
        item.setLevel(1); // Not LEVEL_NORMAL to trigger setNumID
        item.setItem("Test item");
        
        List<NumberingItemRenderData> items = Arrays.asList(item);
        List<NumberingFormat> formats = Arrays.asList(NumberingFormat.DECIMAL);
        NumberingRenderData data = new NumberingRenderData(formats, items);

        // Create mock NiceXWPFDocument that returns a BigInteger for numID
        NiceXWPFDocument mockDocument = Mockito.mock(NiceXWPFDocument.class);
        BigInteger testNumId = BigInteger.valueOf(123);
        Mockito.when(mockDocument.addNewMultiLevelNumberingId(Mockito.any(NumberingFormat[].class)))
               .thenReturn(testNumId);

        // Create mock XWPFParagraph that will receive setNumID call
        XWPFParagraph mockParagraph = Mockito.mock(XWPFParagraph.class);
        Mockito.when(mockParagraph.createRun()).thenReturn(Mockito.mock(XWPFRun.class));

        // Create mock BodyContainer that returns our mock paragraph
        BodyContainer mockBodyContainer = Mockito.mock(BodyContainer.class);
        Mockito.when(mockBodyContainer.insertNewParagraph(Mockito.any(XWPFRun.class)))
               .thenReturn(mockParagraph);

        // Mock BodyContainerFactory to return our mock BodyContainer
        Mockito.mockStatic(BodyContainerFactory.class).when(
                () -> BodyContainerFactory.getBodyContainer(Mockito.any(XWPFRun.class))
        ).thenReturn(mockBodyContainer);

        // Create mock parent paragraph and document structure
        XWPFParagraph mockParentPara = Mockito.mock(XWPFParagraph.class);
        Mockito.when(mockParentPara.getDocument()).thenReturn(mockDocument);

        // Create real XWPFRun with mocked parent
        XWPFRun run = Mockito.mock(XWPFRun.class);
        Mockito.when(run.getParent()).thenReturn(mockParentPara);

        // Mock StyleUtils to avoid NPE during execution
        Mockito.mockStatic(StyleUtils.class);

        // Execute the entry point method
        NumberingRenderPolicy.Helper.renderNumbering(run, data);
    }
}

