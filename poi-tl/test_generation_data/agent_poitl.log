    public void testRenderPathToAddRow() throws Exception {
        // Create a minimal template document with a table containing a template tag
        XWPFDocument document = new XWPFDocument();
        XWPFTable table = document.createTable(1, 1);
        XWPFTableCell cell = table.getRow(0).getCell(0);
        XWPFRun run = cell.getParagraphs().get(0).createRun();
        run.setText("{{#table}}");
        
        // Configure to use MultipleRowTableRenderPolicy for table tags
        Configure config = Configure.builder()
                .bind("table", new MultipleRowTableRenderPolicy())
                .build();
        
        // Create XWPFTemplate using the compile method
        XWPFTemplate template = XWPFTemplate.compile(document, config);
        
        // Prepare data model that will trigger the table rendering
