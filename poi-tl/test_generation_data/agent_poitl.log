        ParagraphRenderData paragraphData = new ParagraphRenderData();
        paragraphData.addText("Nested content");
        DocumentRenderData documentData = new DocumentRenderData(Arrays.asList(paragraphData));
        
        // Configure to bind the template tag to DocumentRenderPolicy
        Configure configure = Configure.builder()
                .bind("var", new DocumentRenderPolicy())
                .build();
        
        // Create a new template with the document containing the template tag
        XWPFDocument docWithTag = new NiceXWPFDocument();
        XWPFRun tagRun = docWithTag.createParagraph().createRun();
        tagRun.setText("{{var}}");
        
        XWPFTemplate templateWithTag = XWPFTemplate.compile(docWithTag, configure);
        
        // Render with the document data
        ByteArrayOutputStream out = new ByteArrayOutputStream();
        templateWithTag.render(Collections.singletonMap("var", documentData), out);
        
        // Clean up
        template.close();
        templateWithTag.close();
        out.close();
        document.close();
        docWithTag.close();
