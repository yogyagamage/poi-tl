    private ParagraphStyle createParagraphStyle() {
        ParagraphStyle style = new ParagraphStyle();
        style.setAlign(ParagraphAlignment.LEFT);
        style.setSpacing(1.0);
        style.setSpacingRule(LineSpacingRule.AUTO);
        style.setSpacingBeforeLines(2.0);
        style.setSpacingAfterLines(2.0);
