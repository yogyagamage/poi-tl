import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import java.util.ArrayList;
import java.util.List;

class SingleSeriesChartTemplateRenderPolicy_AbstractChartTemplateRenderPolicyupdateCTTable_CTTablesetRefFikaTest {

    @Test
    void testUpdateCTTable() throws Exception {
        XSSFWorkbook workbook = new XSSFWorkbook();
        XSSFSheet sheet = workbook.createSheet();
        sheet.createRow(0).createCell(0).setCellValue("Category");
        
        List<SeriesRenderData> seriesDatas = new ArrayList<>();
        SeriesRenderData seriesData = Mockito.mock(SeriesRenderData.class);
        Mockito.when(seriesData.getValues()).thenReturn(new Double[]{1.0, 2.0});
        Mockito.when(seriesData.getName()).thenReturn("Series1");
        seriesDatas.add(seriesData);
        
        AbstractChartTemplateRenderPolicy policy = new AbstractChartTemplateRenderPolicy() {
            @Override
            protected CTTable getSheetTable(XSSFSheet sheet) {
                try {
                    CTTable ctTable = CTTable.Factory.newInstance();
                    CTTableColumns columns = ctTable.addNewTableColumns();
                    columns.addNewTableColumn();
                    return ctTable;
                } catch (Exception e) {
                    throw new RuntimeException(e);
                }
            }
        };
        
        policy.updateCTTable(sheet, seriesDatas);
        workbook.close();
    }
}

