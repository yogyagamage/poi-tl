        when(mockRun.getParent()).thenReturn(mockParagraph);
        
        createHyperlink(mockRun, "http://example.com");
    }

    private static XWPFRun createHyperlink(XWPFRun run, String url) {
        XWPFParagraphWrapper paragraph = new XWPFParagraphWrapper(((XWPFParagraph) (run.getParent())));
        XWPFRun hyperlink = paragraph.insertNewHyperLinkRun(run, url);
        StyleUtils.styleRun(hyperlink, run);
        run.setText("", 0);
        return hyperlink;
    }

    private static class XWPFParagraphWrapper {
        private final XWPFParagraph paragraph;
        
        public XWPFParagraphWrapper(XWPFParagraph paragraph) {
            this.paragraph = paragraph;
        }
        
        public XWPFRun insertNewHyperLinkRun(XWPFRun run, String url) {
            return Mockito.mock(XWPFRun.class);
        }
    }
    
    private static class StyleUtils {
        public static void styleRun(XWPFRun hyperlink, XWPFRun run) {
            // No-op implementation
        }
    }
}

