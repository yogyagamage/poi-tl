        // Create the Series instance using reflection since constructor is package-private
        XDDFOfPieChartData.Series series = new XDDFOfPieChartData.Series(chartData, ctPieSer);
        
        // First call: should create DLbls and add ShowLeaderLines
        series.setShowLeaderLines(true);
        
        // Second call: should invoke CTBoolean.setVal() on existing ShowLeaderLines
        series.setShowLeaderLines(false);
    }
}

