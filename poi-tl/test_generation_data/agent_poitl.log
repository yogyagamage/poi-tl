        // Create source document with numbering
        XWPFDocument sourceDoc = new XWPFDocument();
        XWPFNumbering sourceNumbering = sourceDoc.createNumbering();
        NiceXWPFDocument source = new NiceXWPFDocument(sourceDoc);
        
        // Create merged document with numbering that triggers isSetTmpl()
        XWPFDocument mergedDoc = new XWPFDocument();
        XWPFNumbering mergedNumbering = mergedDoc.createNumbering();
        
        // Create CTAbstractNum with template set
        CTAbstractNum ctAbstractNum = CTAbstractNum.Factory.newInstance();
        ctAbstractNum.setTmpl(CTAbstractNum.Tmpl.Factory.newInstance());
        ctAbstractNum.getTmpl().setVal(BigInteger.valueOf(1));
        
        // Create XWPFNum with reference to the abstract num
        CTNum ctNum = CTNum.Factory.newInstance();
        ctNum.setNumId(BigInteger.valueOf(100));
        ctNum.setAbstractNumId(ctAbstractNum.getAbstractNumId());
        
        // Add the abstract numbering to the merged document
        mergedNumbering.addAbstractNum(new org.apache.poi.xwpf.usermodel.XWPFAbstractNum(ctAbstractNum));
        
        NiceXWPFDocument merged = new NiceXWPFDocument(mergedDoc);
        
        // Create iterator with the merged document
        List<NiceXWPFDocument> docs = Arrays.asList(merged);
        Iterator<NiceXWPFDocument> iterator = docs.iterator();
        
        // Create a run in the source document
        XWPFParagraph paragraph = sourceDoc.createParagraph();
        XWPFRun run = paragraph.createRun();
        run.setText("Test");
        
        // Create the merger and execute the entry point
        XmlXWPFDocumentMerge merger = new XmlXWPFDocumentMerge();
        merger.merge(source, iterator, run);
    }
}

