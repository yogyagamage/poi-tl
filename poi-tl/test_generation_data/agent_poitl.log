class MultiSeriesChartTemplateRenderPolicy_AbstractChartTemplateRenderPolicysetCTTitle_CTTextBodyremovePFikaTest {

    @Test
    void testSetCTTitle() throws Exception {
        CTTitle ctTitle = mock(CTTitle.class);
        CTTx tx = mock(CTTx.class);
        CTRich rich = mock(CTRich.class);
        CTTextBody body = mock(CTTextBody.class);
        CTTextParagraph paragraph = mock(CTTextParagraph.class);
        CTRegularTextRun textRun = mock(CTRegularTextRun.class);

        when(ctTitle.isSetTx()).thenReturn(false);
        when(ctTitle.addNewTx()).thenReturn(tx);
        when(ctTitle.getTx()).thenReturn(tx);
        when(tx.isSetStrRef()).thenReturn(true);
        when(tx.isSetRich()).thenReturn(false);
        when(tx.addNewRich()).thenReturn(rich);
        when(tx.getRich()).thenReturn(rich);
        when(rich.sizeOfPArray()).thenReturn(3);
        when(rich.getPArray(anyInt())).thenReturn(paragraph);
        when(paragraph.sizeOfRArray()).thenReturn(2);
        when(paragraph.getRArray(anyInt())).thenReturn(textRun);

        MultiSeriesChartTemplateRenderPolicy_AbstractChartTemplateRenderPolicysetCTTitle_CTTextBodyremovePFikaTest testInstance = 
            new MultiSeriesChartTemplateRenderPolicy_AbstractChartTemplateRenderPolicysetCTTitle_CTTextBodyremovePFikaTest();
        
        java.lang.reflect.Method method = testInstance.getClass().getDeclaredMethod(
            "setCTTitle", 
            CTTitle.class, 
            String.class
        );
        method.setAccessible(true);
        method.invoke(testInstance, ctTitle, "Test Title");
    }

    private boolean setCTTitle(CTTitle ctTitle, String title) {
        boolean isSet = false;
        if (null != ctTitle) {
            if (!ctTitle.isSetTx()) {
                ctTitle.addNewTx();
            }
            CTTx tx = ctTitle.getTx();
            if (tx.isSetStrRef()) {
                tx.unsetStrRef();
            }
            if (!tx.isSetRich()) {
                tx.addNewRich();
            }
            CTTextBody body = tx.getRich();
            if (body.sizeOfPArray() > 0) {
                for (int i = body.sizeOfPArray() - 1; i > 0; i--) {
                    body.removeP(i);
                }
                CTTextParagraph pArray = body.getPArray(0);
                if (pArray.sizeOfRArray() > 0) {
                    for (int i = pArray.sizeOfRArray() - 1; i > 0; i--) {
                        pArray.removeR(i);
                    }
                    CTRegularTextRun rArray = pArray.getRArray(0);
                    rArray.setT(title);
                    isSet = true;
                }
            }
        }
        return isSet;
    }
}

