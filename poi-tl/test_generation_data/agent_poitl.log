package com.deepoove.poi.xwpf;

import org.junit.jupiter.api.Test;
import org.apache.xmlbeans.XmlCursor;
import org.apache.poi.xwpf.usermodel.XWPFParagraph;
import org.openxmlformats.schemas.wordprocessingml.x2006.main.CTHyperlink;
import org.openxmlformats.schemas.wordprocessingml.x2006.main.CTP;
import org.openxmlformats.schemas.wordprocessingml.x2006.main.CTR;
import org.openxmlformats.schemas.wordprocessingml.x2006.main.CTFldSimple;
import org.openxmlformats.schemas.wordprocessingml.x2006.main.CTBookmark;
import org.openxmlformats.schemas.wordprocessingml.x2006.main.CTMarkupRange;

public class XWPFParagraphWrappermethod_QNamemethodFikaTest3 {

    @Test
    public void testQNameConstructorInvocation() throws Exception {
        CTP ctp = CTP.Factory.newInstance();
        XWPFParagraph paragraph = new XWPFParagraph(ctp, null);
        XWPFParagraphWrapper wrapper = new XWPFParagraphWrapper(paragraph);
        
        XmlCursor cursor = ctp.newCursor();
        cursor.toFirstChild();
        
        CTHyperlink hyperlink = ctp.addNewHyperlink();
        hyperlink.setId("testId");
        CTR ctr = hyperlink.addNewR();
        ctr.addNewT().setStringValue("hyperlink text");
        
        CTFldSimple fldSimple = ctp.addNewFldSimple();
        fldSimple.setInstr("test");
        
        CTR run = ctp.addNewR();
        run.addNewT().setStringValue("run text");
        
        CTBookmark bookmarkStart = ctp.addNewBookmarkStart();
        bookmarkStart.setId("bookmark1");
        bookmarkStart.setName("bookmarkName");
        
        CTBookmark bookmarkEnd = ctp.addNewBookmarkEnd();
        bookmarkEnd.setId("bookmark1");
        
        CTMarkupRange commentStart = ctp.addNewCommentRangeStart();
        commentStart.setId("comment1");
        
        CTMarkupRange commentEnd = ctp.addNewCommentRangeEnd();
        commentEnd.setId("comment1");
        
        wrapper.getRuns();
    }
}

