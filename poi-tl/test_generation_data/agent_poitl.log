    @Test
    public void testMergeExternalPicture() throws InvalidFormatException {
        NiceXWPFDocument source = Mockito.mock(NiceXWPFDocument.class);
        NiceXWPFDocument merged = Mockito.mock(NiceXWPFDocument.class);
        
        PackagePart mergedPackagePart = Mockito.mock(PackagePart.class);
        PackagePart sourcePackagePart = Mockito.mock(PackagePart.class);
        
        PackageRelationshipCollection imagePart = Mockito.mock(PackageRelationshipCollection.class);
        Iterator<PackageRelationship> iterator = Mockito.mock(Iterator.class);
        PackageRelationship relationship = Mockito.mock(PackageRelationship.class);
        PackageRelationship relationshipNew = Mockito.mock(PackageRelationship.class);
        
        when(merged.getPackagePart()).thenReturn(mergedPackagePart);
        when(source.getPackagePart()).thenReturn(sourcePackagePart);
        when(mergedPackagePart.getRelationshipsByType(PackageRelationshipTypes.IMAGE_PART)).thenReturn(imagePart);
        when(imagePart.iterator()).thenReturn(iterator);
        
        when(iterator.hasNext()).thenReturn(true, false);
        when(iterator.next()).thenReturn(relationship);
        when(relationship.getTargetMode()).thenReturn(TargetMode.EXTERNAL);
        when(relationship.getTargetURI()).thenReturn(new java.net.URI("http://example.com/image.png"));
        when(relationship.getId()).thenReturn("rId1");
        
        when(sourcePackagePart.addExternalRelationship(
                "http://example.com/image.png", 
                XWPFRelation.IMAGES.getRelation()))
            .thenReturn(relationshipNew);
        when(relationshipNew.getId()).thenReturn("rId2");
        
        mergeExternalPicture(source, merged);
    }
    
    protected Map<String, String> mergeExternalPicture(NiceXWPFDocument source, NiceXWPFDocument merged) throws InvalidFormatException {
        Map<String, String> blipIdsMap = new HashMap<String, String>();
        PackageRelationshipCollection imagePart = merged.getPackagePart().getRelationshipsByType(PackageRelationshipTypes.IMAGE_PART);
        Iterator<PackageRelationship> iterator = imagePart.iterator();
        while (iterator.hasNext()) {
