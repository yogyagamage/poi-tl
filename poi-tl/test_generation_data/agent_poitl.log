    double spacingBetween = paragraph.getSpacingBetween();
    if ((-1) != spacingBetween) {
        builder.withSpacing(spacingBetween);
        builder.withSpacingRule(paragraph.getSpacingLineRule());
    }
    return builder.build();
}

