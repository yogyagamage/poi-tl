    @Test
    public void testMergePathToXmlCursorHasNextToken() throws Exception {
        // Create XmlXWPFDocumentMerge instance using constructor
        XmlXWPFDocumentMerge merge = new XmlXWPFDocumentMerge();
        
        // Create a minimal NiceXWPFDocument for source
        NiceXWPFDocument sourceDoc = createMinimalNiceXWPFDocument();
        
        // Create a minimal NiceXWPFDocument for merging
        NiceXWPFDocument mergeDoc = createMinimalNiceXWPFDocument();
        
        // Create iterator with mergeDoc
        List<NiceXWPFDocument> docs = new ArrayList<>();
        docs.add(mergeDoc);
        Iterator<NiceXWPFDocument> iterator = docs.iterator();
        
