        NumberingItemRenderData item2 = new NumberingItemRenderData("Item 2", 2);
        List<NumberingItemRenderData> items = Arrays.asList(item1, item2);
        NumberingRenderData data = new NumberingRenderData(items, Arrays.asList(NumberingFormat.DECIMAL));
        
        // Mock BodyContainer to return real paragraphs
        BodyContainer mockBodyContainer = Mockito.mock(BodyContainer.class);
        Mockito.when(BodyContainerFactory.getBodyContainer(mockRun)).thenReturn(mockBodyContainer);
        
