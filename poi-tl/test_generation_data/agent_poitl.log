    private NiceXWPFDocument createMinimalNiceXWPFDocument() throws IOException, InvalidFormatException {
        // Create minimal DOCX content
        String minimalDoc = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>" +
                "<w:document xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\">" +
                "<w:body><w:p><w:r><w:t>Test</w:t></w:r></w:p></w:body>" +
                "</w:document>";
        
        ByteArrayInputStream input = new ByteArrayInputStream(minimalDoc.getBytes());
        return new NiceXWPFDocument(input);
    }
    
    private XWPFRun createMinimalXWPFRun(NiceXWPFDocument doc) {
        // Get or create a paragraph
        List<XWPFParagraph> paragraphs = doc.getParagraphs();
        XWPFParagraph paragraph;
        if (paragraphs.isEmpty()) {
            paragraph = doc.createParagraph();
        } else {
            paragraph = paragraphs.get(0);
        }
        
        // Get or create a run
        List<XWPFRun> runs = paragraph.getRuns();
        if (runs.isEmpty()) {
            return paragraph.createRun();
        } else {
            return runs.get(0);
        }
    }
}

