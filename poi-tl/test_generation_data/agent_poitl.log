import org.junit.jupiter.api.Test;

import java.io.ByteArrayInputStream;
import java.io.ByteArrayOutputStream;

public class TOCRenderPolicyrender_XWPFRunsetTextFikaTest {

    @Test
    public void testRender() throws Exception {
        TOCRenderPolicy policy = new TOCRenderPolicy();

        XWPFDocument document = new XWPFDocument();
        XWPFParagraph paragraph = document.createParagraph();
        XWPFRun run = paragraph.createRun();

        ElementTemplate elementTemplate = new RunTemplate(run, "toc");

        XWPFDocument templateDocument = new XWPFDocument();
        templateDocument.createParagraph();
        ByteArrayOutputStream templateBytes = new ByteArrayOutputStream();
        templateDocument.write(templateBytes);
        templateDocument.close();
        XWPFTemplate template = XWPFTemplate.compile(new ByteArrayInputStream(templateBytes.toByteArray()));

        policy.render(elementTemplate, "data", template);
    }
}

