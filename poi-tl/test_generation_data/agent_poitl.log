public void doRender(RenderContext<AttachmentRenderData> context) throws Exception {
    NiceXWPFDocument doc = context.getXWPFDocument();
    XWPFRun run = context.getRun();
    CTR ctr = run.getCTR();
    // Only one shapetype is needed
