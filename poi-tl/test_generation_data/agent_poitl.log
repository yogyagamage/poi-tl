        data.add("item1");
        data.add("item2");
        
        // Create policy instance
        RenderPolicy policy = new MultipleRowTableRenderPolicy();
        
        // Invoke render method - this should trigger table.addRow() internally
        policy.render(runTemplate, data, mockTemplate);
    }
}

