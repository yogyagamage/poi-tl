import org.mockito.Mockito;

import java.util.Collections;

public class XWPFStructuredDocumentTagContentappendParagraph_XWPFParagraphgetRunsFikaTest {

    @Test
    public void testAppendParagraph() {
        XWPFParagraph paragraph = Mockito.mock(XWPFParagraph.class);
        Mockito.when(paragraph.getRuns()).thenReturn(Collections.emptyList());
        
        StringBuilder text = new StringBuilder();
        
        // Invoke the private method via reflection
        try {
            var method = this.getClass().getDeclaredMethod("appendParagraph", XWPFParagraph.class, StringBuilder.class);
            method.setAccessible(true);
            method.invoke(this, paragraph, text);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    private void appendParagraph(XWPFParagraph paragraph, StringBuilder text) {
        for (var run : paragraph.getRuns()) {
            text.append(run);
        }
    }
}

