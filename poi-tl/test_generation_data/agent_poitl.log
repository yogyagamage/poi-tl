public List<MetaTemplate> resolveXWPFRuns(List<XWPFRun> runs) // PATH: Test should invoke the next TemplateResolver.resolveXWPFRuns(...) [step in execution path]
{
    List<MetaTemplate> metaTemplates = new ArrayList<>();
