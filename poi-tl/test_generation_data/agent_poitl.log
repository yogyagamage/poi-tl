package com.deepoove.poi.plugin.comment;

import org.apache.poi.xwpf.usermodel.XWPFComment;
import org.apache.poi.xwpf.usermodel.XWPFRun;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.math.BigInteger;

public class HelperrenderComment_XWPFCommentsetInitialsFikaTest {

    @Test
    public void testRenderComment() throws Exception {
        // Create mock XWPFRun
        XWPFRun mockRun = Mockito.mock(XWPFRun.class);
        
        // Create CommentRenderData with non-null CommentContent
        CommentRenderData data = new CommentRenderData();
        CommentContent commentContent = new CommentContent();
        commentContent.setAuthor("Test Author");
        commentContent.setDate("2024-01-01");
        commentContent.setInitials("TA");
        commentContent.setContent("Test comment content");
        data.setCommentContent(commentContent);
        
        // Create mock paragraph and document chain
        org.apache.poi.xwpf.usermodel.XWPFParagraph mockParagraph = 
            Mockito.mock(org.apache.poi.xwpf.usermodel.XWPFParagraph.class);
        Mockito.when(mockRun.getParent()).thenReturn(mockParagraph);
        
        NiceXWPFDocument mockDocument = Mockito.mock(NiceXWPFDocument.class);
        Mockito.when(mockParagraph.getDocument()).thenReturn(mockDocument);
        
        // Create mock comments and comment
        org.apache.poi.xwpf.usermodel.XWPFComments mockComments = 
            Mockito.mock(org.apache.poi.xwpf.usermodel.XWPFComments.class);
        Mockito.when(mockDocument.createComments()).thenReturn(mockComments);
        
        XWPFComment mockComment = Mockito.mock(XWPFComment.class);
        Mockito.when(mockComments.createComment(Mockito.any(BigInteger.class)))
               .thenReturn(mockComment);
        
        // Mock NextIDUtils.getCommentMaxId to return BigInteger.ZERO
        Mockito.mockStatic(NextIDUtils.class).when(
            () -> NextIDUtils.getCommentMaxId(Mockito.any(org.apache.poi.xwpf.usermodel.XWPFComments.class))
        ).thenReturn(BigInteger.ZERO);
        
        // Mock CTComment
        org.openxmlformats.schemas.wordprocessingml.x2006.main.CTComment mockCtComment = 
            Mockito.mock(org.openxmlformats.schemas.wordprocessingml.x2006.main.CTComment.class);
        Mockito.when(mockComment.getCtComment()).thenReturn(mockCtComment);
        Mockito.when(mockCtComment.getId()).thenReturn(BigInteger.ONE);
        
        // Mock paragraph creation from comment
        org.apache.poi.xwpf.usermodel.XWPFParagraph mockCommentParagraph = 
            Mockito.mock(org.apache.poi.xwpf.usermodel.XWPFParagraph.class);
        Mockito.when(mockComment.createParagraph()).thenReturn(mockCommentParagraph);
        
        XWPFRun mockCommentRun = Mockito.mock(XWPFRun.class);
        Mockito.when(mockCommentParagraph.createRun()).thenReturn(mockCommentRun);
        
        // Execute the entry point method
        CommentRenderPolicy.Helper.renderComment(mockRun, data);
    }
}

