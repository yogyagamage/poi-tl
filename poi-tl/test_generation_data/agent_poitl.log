        NiceXWPFDocument mockDocument = Mockito.mock(NiceXWPFDocument.class);
        
        // Setup mock chain for run.getParent().getDocument()
        Mockito.when(mockRun.getParent()).thenReturn(mockParent);
        Mockito.when(mockParent.getDocument()).thenReturn(mockDocument);
        
