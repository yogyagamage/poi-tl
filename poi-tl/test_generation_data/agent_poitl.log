public static void styleParaRpr(XWPFParagraph paragraph, Style style) // PATH: Test should invoke the next StyleUtils.styleParaRpr(...) [step in execution path]
{
    if ((null == paragraph) || (null == style)) {
        return;
    }
    CTP ctp = paragraph.getCTP();
    CTPPr pPr = (ctp.isSetPPr()) ? ctp.getPPr() : ctp.addNewPPr();
    CTParaRPr pr = (pPr.isSetRPr()) ? pPr.getRPr() : pPr.addNewRPr();
    StyleUtils.styleParaRpr(pr, style);
}

/**
 * set w:rPr style
 *
 * @param pr
