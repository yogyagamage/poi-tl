        italic.setVal(style.isItalic() ? XWPFOnOff.ON : XWPFOnOff.OFF);
    }
    if (null != style.isBold()) {
        CTOnOff bold = (pr.sizeOfBArray() > 0) ? pr.getBArray(0) : pr.addNewB();
