    private XWPFTableCell getActualCell(XWPFTableRow tableRow, int insertPosition) {
        int orginalCol = 0;
        for (int i = 0; i < tableRow.getTableCells().size(); i++) {
            XWPFTableCell current = tableRow.getCell(i);
            int intValue = 1;
            org.openxmlformats.schemas.wordprocessingml.x2006.main.CTTcPr tcPr = current.getCTTc().getTcPr();
            if (null != tcPr) {
                org.openxmlformats.schemas.wordprocessingml.x2006.main.CTDecimalNumber gridSpan = tcPr.getGridSpan();
                if (null != gridSpan) {
                    intValue = gridSpan.getVal().intValue();
                }
            }
            orginalCol += intValue;
            if ((orginalCol - 1) >= insertPosition) {
                return current;
            }
        }
        return null;
    }
}

