        Mockito.when(item.getItem()).thenReturn(Mockito.mock(ParagraphRenderData.class));
        
        List<NumberingItemRenderData> items = new ArrayList<>();
        items.add(item);
        
        NumberingRenderData data = Mockito.mock(NumberingRenderData.class);
        Mockito.when(data.getItems()).thenReturn(items);
        Mockito.when(data.getFormats()).thenReturn(Arrays.asList(NumberingFormat.DECIMAL));
        
        // Execute the entry point method
        NumberingRenderPolicy.Helper.renderNumbering(mockRun, data);
    }
}

