    @Test
    public void testUpdateNumberingTriggersUnsetTmpl() throws Exception {
        // Create a real document
        XWPFDocument document = new XWPFDocument();
        
        // Create real numbering
        XWPFNumbering numbering = document.createNumbering();
        
        // Create a real CTAbstractNum with template set
        CTAbstractNum ctAbstractNum = CTAbstractNum.Factory.newInstance();
        ctAbstractNum.setTmpl(CTAbstractNum.Tmpl.Factory.newInstance());
        
        // Create XWPFAbstractNum wrapper
        XWPFAbstractNum abstractNum = new XWPFAbstractNum(ctAbstractNum);
        BigInteger abstractNumId = numbering.addAbstractNum(abstractNum);
        
        // Create a real num referencing the abstract num
        CTNum ctNum = CTNum.Factory.newInstance();
        ctNum.setAbstractNumId(abstractNumId);
        XWPFNum num = new XWPFNum(ctNum, numbering);
        
        // Register the num in numbering with an ID
        BigInteger numID = BigInteger.valueOf(1);
        // We need to work around the package-private access to numbering's internal map
        // by using reflection or creating a document structure that will be found
        // We'll create a simple document structure that will trigger the path
        
        // Create source paragraph
        XWPFParagraph sourceParagraph = document.createParagraph();
        // We need to set the numID on the paragraph's CTParagraph
        sourceParagraph.getCTP().getPPr().getNumPr().setNumId(numID);
        
        // Create target paragraph
        XWPFParagraph targetParagraph = document.createParagraph();
        
        // Create NumberingContinue instance
        NumberingContinue numberingContinue = new NumberingContinue();
        
        // Manually populate the numbering map using reflection
        java.lang.reflect.Field numMapField = XWPFNumbering.class.getDeclaredField("numMap");
        numMapField.setAccessible(true);
        @SuppressWarnings("unchecked")
        HashMap<BigInteger, XWPFNum> numMap = (HashMap<BigInteger, XWPFNum>) numMapField.get(numbering);
        numMap.put(numID, num);
        
        // Also populate abstract num map
        java.lang.reflect.Field abstractNumMapField = XWPFNumbering.class.getDeclaredField("abstractNumMap");
        abstractNumMapField.setAccessible(true);
        @SuppressWarnings("unchecked")
        HashMap<BigInteger, XWPFAbstractNum> abstractNumMap = 
            (HashMap<BigInteger, XWPFAbstractNum>) abstractNumMapField.get(numbering);
        abstractNumMap.put(abstractNumId, abstractNum);
        
        // Execute the entry point method
        numberingContinue.updateNumbering(sourceParagraph, targetParagraph);
    }
}

