        Mockito.when(ctNum.getAbstractNumId()).thenReturn(
            org.openxmlformats.schemas.wordprocessingml.x2006.main.CTDecimalNumber.Factory.newInstance()
        );
        Mockito.when(ctNum.getAbstractNumId().getVal()).thenReturn(abstractNumId);
        
        // Setup XWPFAbstractNum with CTAbstractNum that has nsid set
        XWPFAbstractNum abstractNum = Mockito.mock(XWPFAbstractNum.class);
        CTAbstractNum ctAbstractNum = CTAbstractNum.Factory.newInstance();
        ctAbstractNum.setNsid(CTAbstractNum.Nsid.Factory.newInstance());
        Mockito.when(abstractNum.getAbstractNum()).thenReturn(ctAbstractNum);
        
        // Setup numbering wrapper
        XWPFNumberingWrapper wrapper = Mockito.mock(XWPFNumberingWrapper.class);
        Mockito.when(wrapper.getNextAbstractNumID()).thenReturn(BigInteger.valueOf(100));
        
        // Mock the static factory method call in XWPFNumberingWrapper constructor
