    private byte[] createMinimalDocxWithChart() throws IOException {
        // Create a minimal .docx with a chart template
        NiceXWPFDocument doc = new NiceXWPFDocument();
        doc.createParagraph().createRun().setText("{{chart}}");
        
        // Create a chart and add it to the document
        XWPFChart chart = doc.createChart(10, 10);
        
