    @Test
    public void testResolveBodyElementsToGetRelationById() throws Exception {
        // Create a real XWPFDocument
        XWPFDocument document = new XWPFDocument();
        
        // Create a run with chart drawing
        XWPFParagraph paragraph = document.createParagraph();
        XWPFRun run = paragraph.createRun();
        
        // Create CTDrawing with chart reference
        org.openxmlformats.schemas.drawingml.x2006.main.CTDrawing ctDrawing = 
            org.openxmlformats.schemas.drawingml.x2006.main.CTDrawing.Factory.newInstance();
        org.openxmlformats.schemas.drawingml.x2006.wordprocessingDrawing.CTInline inline = 
            org.openxmlformats.schemas.drawingml.x2006.wordprocessingDrawing.CTInline.Factory.newInstance();
        
        // Add graphic with chart reference
        org.openxmlformats.schemas.drawingml.x2006.main.CTGraphicalObject graphic = 
            org.openxmlformats.schemas.drawingml.x2006.main.CTGraphicalObject.Factory.newInstance();
        org.openxmlformats.schemas.drawingml.x2006.main.CTGraphicalObjectData graphicData = 
            org.openxmlformats.schemas.drawingml.x2006.main.CTGraphicalObjectData.Factory.newInstance();
        graphicData.setUri("http://schemas.openxmlformats.org/drawingml/2006/chart");
        
        // Create chart relation
        String chartRid = document.getPackagePart().addExternalRelationship(
            "http://schemas.openxmlformats.org/officeDocument/2006/relationships/chart",
            new org.apache.poi.openxml4j.opc.PackagePartName() {
                public String getName() {
                    return "/word/charts/chart1.xml";
                }
                public int compareTo(org.apache.poi.openxml4j.opc.PackagePartName o) {
                    return 0;
                }
            }
        ).getId();
        
        // Create c:chart element with r:id attribute
        javax.xml.namespace.QName chartQName = new javax.xml.namespace.QName(
            "http://schemas.openxmlformats.org/drawingml/2006/chart", 
            "chart"
        );
        org.apache.xmlbeans.XmlObject chartXml = org.apache.xmlbeans.XmlObject.Factory.newInstance();
        org.apache.xmlbeans.XmlCursor cursor = chartXml.newCursor();
        cursor.toNextToken();
        cursor.beginElement(chartQName);
        cursor.insertAttributeWithValue(new javax.xml.namespace.QName("http://schemas.openxmlformats.org/officeDocument/2006/relationships", "id"), chartRid);
        cursor.dispose();
        
        graphicData.set(chartXml);
        graphic.setGraphicData(graphicData);
        
        // Build the drawing structure
        org.openxmlformats.schemas.drawingml.x2006.wordprocessingDrawing.CTAnchor anchor = 
            org.openxmlformats.schemas.drawingml.x2006.wordprocessingDrawing.CTAnchor.Factory.newInstance();
        anchor.setGraphic(graphic);
        ctDrawing.addNewAnchor().set(anchor);
        
        // Set the drawing to the run using reflection
        java.lang.reflect.Field drawingField = XWPFRun.class.getDeclaredField("drawing");
        drawingField.setAccessible(true);
        drawingField.set(run, ctDrawing);
        
        // Create SDT content with run
        CTSdtBlock ctSdtBlock = org.openxmlformats.schemas.wordprocessingml.x2006.main.CTSdtBlock.Factory.newInstance();
        CTSdtContentBlock contentBlock = ctSdtBlock.addNewSdtContent();
        contentBlock.addNewP().set(paragraph.getCTParagraph());
        
        XWPFStructuredDocumentTag sdt = new XWPFStructuredDocumentTag(
            ctSdtBlock, 
            document, 
            new org.apache.poi.xwpf.usermodel.IBody() {
                public XWPFDocument getDocument() { return document; }
                public POIXMLDocumentPart getPart() { return document; }
                public BodyType getPartType() { return BodyType.DOCUMENT; }
                public org.apache.xmlbeans.XmlObject getCTBody() { return null; }
                public void setXWPFDocument(XWPFDocument doc) {}
            }
        );
        
        XWPFStructuredDocumentTagContent sdtContent = new XWPFStructuredDocumentTagContent(
            ctSdtBlock.getSdtContent(), 
            sdt, 
            document
        );
        
        // Create mock objects for TemplateResolver constructor parameters
        com.deepoove.poi.config.Configure config = Mockito.mock(com.deepoove.poi.config.Configure.class);
        com.deepoove.poi.template.MetaTemplateFactory metaTemplateFactory = 
            Mockito.mock(com.deepoove.poi.template.MetaTemplateFactory.class);
        
        // Create TemplateResolver instance
        TemplateResolver resolver = new TemplateResolver(config, metaTemplateFactory);
        
        // Create body elements list containing the SDT
        List<IBodyElement> bodyElements = new ArrayList<>();
        bodyElements.add(sdt);
        
        // Execute the entry point method - this should trigger the full call chain
        // including XWPFDocument.getRelationById()
        resolver.resolveBodyElements(bodyElements);
    }
}

