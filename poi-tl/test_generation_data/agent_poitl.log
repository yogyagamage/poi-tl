import org.openxmlformats.schemas.wordprocessingml.x2006.main.CTPPr;
import org.openxmlformats.schemas.wordprocessingml.x2006.main.CTParaRPr;

import java.math.BigDecimal;
import java.math.RoundingMode;

public class StyleUtilsstyleParaRpr_CTFontssetAsciiFikaTest {

    @Test
    public void testStyleParaRpr() throws Exception {
        // Create a real XWPFParagraph using reflection since constructor is not public
        XWPFParagraph paragraph = createXWPFParagraph();
        
        // Create a Style with font family to trigger CTFonts.setAscii call
        Style style = new Style();
        style.setFontFamily("Arial");
        
        // Call the entry point method
        StyleUtils.styleParaRpr(paragraph, style);
    }
    
    private XWPFParagraph createXWPFParagraph() throws Exception {
        // Create CTP with PPr and RPr structure
        CTP ctp = CTP.Factory.newInstance();
        CTPPr pPr = ctp.addNewPPr();
        CTParaRPr pr = pPr.addNewRPr();
        
        // Create XWPFParagraph using reflection since we need to set internal CTP
        XWPFParagraph paragraph = XWPFParagraph.class.getDeclaredConstructor(CTP.class, Object.class)
                .newInstance(ctp, null);
        
        return paragraph;
    }
}

