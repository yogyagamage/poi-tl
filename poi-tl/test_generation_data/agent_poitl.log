        XWPFParagraph target = Mockito.mock(XWPFParagraph.class);
        
        // Setup XWPFNum with CTNum
        XWPFNum num = Mockito.mock(XWPFNum.class);
        CTNum ctNum = Mockito.mock(CTNum.class);
        Mockito.when(num.getCTNum()).thenReturn(ctNum);
        
        // Setup abstract num ID
