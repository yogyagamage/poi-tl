package com.deepoove.poi.util;

import com.deepoove.poi.data.style.Style;
import org.apache.poi.xwpf.usermodel.XWPFRun;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import static org.mockito.Mockito.when;

public class StyleUtilsstyleRun_CTColorisSetThemeColorFikaTest {

    @Test
    public void testStyleRun() throws Exception {
        // Create a mock XWPFRun
        XWPFRun mockRun = Mockito.mock(XWPFRun.class);
        
        // Create a mock CTRPr that will be returned by StyleUtils.getRunProperties
        org.openxmlformats.schemas.wordprocessingml.x2006.main.CTRPr mockPr = 
            Mockito.mock(org.openxmlformats.schemas.wordprocessingml.x2006.main.CTRPr.class);
        
        // Create a mock CTColor that will be returned by pr.getColorArray(0) or pr.addNewColor()
        org.openxmlformats.schemas.wordprocessingml.x2006.main.CTColor mockCtColor = 
            Mockito.mock(org.openxmlformats.schemas.wordprocessingml.x2006.main.CTColor.class);
        
        // Mock the static method getRunProperties to return our mock CTRPr
        // We need to use reflection to set up the mock since getRunProperties is static
        // But we'll create a real Style object and configure it to trigger the color path
        
        // Create a real Style object with color set
        Style style = new Style();
        style.setColor("#FF0000"); // This will trigger the color path in styleRun
        
        // Configure mockRun to return mockPr when getCTR() is called
        org.openxmlformats.schemas.wordprocessingml.x2006.main.CTR mockCtr = 
            Mockito.mock(org.openxmlformats.schemas.wordprocessingml.x2006.main.CTR.class);
        when(mockRun.getCTR()).thenReturn(mockCtr);
        when(mockCtr.getRPr()).thenReturn(mockPr);
        
        // Configure mockPr to return an empty color array initially
        when(mockPr.sizeOfColorArray()).thenReturn(0);
        when(mockPr.addNewColor()).thenReturn(mockCtColor);
        
        // Configure mockCtColor.isSetThemeColor() to return true so the method gets called
        when(mockCtColor.isSetThemeColor()).thenReturn(true);
        
        // Call the entry point method
        StyleUtils.styleRun(mockRun, style);
        
        // The test will pass if no exceptions are thrown and 
        // mockCtColor.isSetThemeColor() was invoked during execution
    }
}

