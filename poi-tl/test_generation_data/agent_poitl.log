        public NiceXWPFDocument(XWPFDocument document) {
            this.document = document;
        }
        
        public XWPFDocument getDocument() {
            return document;
        }
        
        public NiceXWPFDocument generate(boolean b) {
            return this;
        }
        
        public List<XWPFFootnote> getFootnotes() {
            return document.getFootnotesList();
        }
        
        public XWPFFootnotes createFootnotes() {
            return document.createFootnotes();
        }
        
        public void close() throws IOException {
            document.close();
        }
    }
    
    private static class XmlXWPFDocumentMerge extends AbstractXWPFDocumentMerge {
        @Override
        public NiceXWPFDocument merge(NiceXWPFDocument source, Iterator<NiceXWPFDocument> mergedIterator, XWPFRun location) throws Exception {
            return super.merge(source, mergedIterator, location);
        }
