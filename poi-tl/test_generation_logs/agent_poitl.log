package com.deepoove.poi.xwpf;

import org.apache.poi.xwpf.usermodel.XWPFParagraph;
import org.apache.poi.xwpf.usermodel.XWPFRun;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.util.Arrays;
import java.util.Iterator;

import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.when;

public class XmlXWPFDocumentMergemergeNumbering_CTAbstractNumunsetNsidFikaTest {

    @Test
    public void testMergePathToUnsetNsid() throws Exception {
        // Create source document with numbering
        NiceXWPFDocument sourceDoc = new NiceXWPFDocument();
        sourceDoc.createNumbering();
        
        // Create merged document with numbering that has CTAbstractNum with nsid set
        byte[] docBytes = createDocxWithNumberingHavingNsid();
        NiceXWPFDocument mergedDoc = new NiceXWPFDocument(new ByteArrayInputStream(docBytes));
        
        // Create iterator with merged document
        Iterator<NiceXWPFDocument> iterator = Arrays.asList(mergedDoc).iterator();
        
        // Create mock run and paragraph
        XWPFRun mockRun = mock(XWPFRun.class);
        XWPFParagraph mockParagraph = mock(XWPFParagraph.class);
        when(mockRun.getParent()).thenReturn(mockParagraph);
        
        // Create XmlXWPFDocumentMerge instance
        XmlXWPFDocumentMerge mergeInstance = new XmlXWPFDocumentMerge();
        
        // Execute the entry point method
        mergeInstance.merge(sourceDoc, iterator, mockRun);
    }
    
    private byte[] createDocxWithNumberingHavingNsid() throws IOException {
        // Create a minimal DOCX with numbering that has nsid set
        NiceXWPFDocument doc = new NiceXWPFDocument();
        
        // Create numbering with abstract num that has nsid
        if (doc.getNumbering() == null) {
            doc.createNumbering();
        }
        
        // Add a paragraph with numbering to ensure numbering is actually created
        XWPFParagraph paragraph = doc.createParagraph();
        paragraph.setNumID(BigInteger.ONE);
        
        // Get the numbering and modify the abstract num to have nsid
        XWPFNumbering numbering = doc.getNumbering();
        if (numbering != null && numbering.getAbstractNum(BigInteger.ZERO) != null) {
            org.openxmlformats.schemas.wordprocessingml.x2006.main.CTAbstractNum ctAbstractNum = 
                numbering.getAbstractNum(BigInteger.ZERO).getCTAbstractNum();
            if (ctAbstractNum != null) {
                ctAbstractNum.setNsid(org.openxmlformats.schemas.wordprocessingml.x2006.main.CTLongHexNumber.Factory.newInstance());
            }
        }
        
        // Write to byte array
        java.io.ByteArrayOutputStream baos = new java.io.ByteArrayOutputStream();
        doc.write(baos);
        doc.close();
        
        return baos.toByteArray();
    }
}

