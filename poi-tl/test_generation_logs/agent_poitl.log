public void doRender(ChartTemplate eleTemplate, ChartMultiSeriesRenderData data, XWPFTemplate template) throws Exception // PATH: Test should invoke the next AbstractChartTemplateRenderPolicy.setTitle(...) [step in execution path]
{
    XWPFChart chart = eleTemplate.getChart();
