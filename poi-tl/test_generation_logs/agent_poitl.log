                ChartTypes.LINE, chart, null, null);
        
        // Add a series to ensure the loop executes
        String[] categories = new String[]{"Cat1", "Cat2"};
        Double[] values = new Double[]{1.0, 2.0};
        
        XDDFDataSource<String> catDataSource = XDDFDataSourcesFactory.fromArray(categories);
        XDDFNumericalDataSource<Double> valDataSource = XDDFDataSourcesFactory.fromArray(values);
        lineChartData.addSeries(catDataSource, valDataSource);
        
        chartSeries.add(lineChartData);
        
        Mockito.when(chartTemplate.getChart()).thenReturn(chart);
        Mockito.when(chart.getChartSeries()).thenReturn(chartSeries);
        
