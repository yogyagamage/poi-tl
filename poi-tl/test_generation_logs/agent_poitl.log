package com.deepoove.poi.xwpf;

import org.apache.poi.xwpf.usermodel.XWPFParagraph;
import org.apache.poi.xwpf.usermodel.XWPFRun;
import org.apache.poi.xwpf.usermodel.XWPFDocument;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.util.Arrays;
import java.util.Iterator;

public class XmlXWPFDocumentMergemergeNumbering_CTAbstractNumunsetTmplFikaTest {

    @Test
    public void testMergePathToUnsetTmpl() throws Exception {
        // Create source document with numbering
        byte[] docBytes = getDocumentWithNumbering();
        NiceXWPFDocument sourceDoc = new NiceXWPFDocument(new ByteArrayInputStream(docBytes));
        
        // Create merged document with numbering that has tmpl set
        NiceXWPFDocument mergedDoc = new NiceXWPFDocument(new ByteArrayInputStream(docBytes));
        
        // Create iterator with the merged document
        Iterator<NiceXWPFDocument> iterator = Arrays.asList(mergedDoc).iterator();
        
        // Get a run from the source document to use as insertion point
        XWPFParagraph paragraph = sourceDoc.createParagraph();
        XWPFRun run = paragraph.createRun();
        run.setText("Insertion point");
        
        // Create instance of class under test
        XmlXWPFDocumentMerge mergeInstance = new XmlXWPFDocumentMerge();
        
        // Execute the entry point method - this should traverse the entire path
        // and eventually call CTAbstractNum.unsetTmpl()
        mergeInstance.merge(sourceDoc, iterator, run);
        
        // Clean up
        sourceDoc.close();
    }
    
    private byte[] getDocumentWithNumbering() throws IOException {
        // Create a document with numbering that will trigger the unsetTmpl() call
        XWPFDocument doc = new XWPFDocument();
        
        // Add numbering to the document
        doc.createNumbering();
        
        // Create a paragraph with numbering
        XWPFParagraph paragraph = doc.createParagraph();
        paragraph.setNumID(BigInteger.ONE);
        
        // Convert to byte array
        java.io.ByteArrayOutputStream baos = new java.io.ByteArrayOutputStream();
        doc.write(baos);
        doc.close();
        
        return baos.toByteArray();
    }
}

