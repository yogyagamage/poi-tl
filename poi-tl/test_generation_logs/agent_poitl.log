package com.deepoove.poi.xwpf;

import org.apache.poi.xwpf.usermodel.XWPFEndnote;
import org.apache.poi.xwpf.usermodel.XWPFParagraph;
import org.apache.poi.xwpf.usermodel.XWPFRun;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.util.*;

import static org.mockito.Mockito.*;

class XmlXWPFDocumentMergemergeEndnote_XWPFEndnotegetCTFtnEdnFikaTest {

    @Test
    void testMergePathToGetCTFtnEdn() throws Exception {
        // Create source document with minimal structure
        NiceXWPFDocument sourceDoc = new NiceXWPFDocument();
        
        // Create merged document with an endnote
        byte[] emptyDocBytes = new byte[0];
        NiceXWPFDocument mergedDoc = new NiceXWPFDocument(new ByteArrayInputStream(emptyDocBytes));
        
        // Create endnotes in merged document
        XWPFEndnote endnote = mock(XWPFEndnote.class);
        when(endnote.getId()).thenReturn(BigInteger.valueOf(1));
        when(endnote.getCTFtnEdn()).thenReturn(org.openxmlformats.schemas.wordprocessingml.x2006.main.CTFtnEdn.Factory.newInstance());
        
        List<XWPFEndnote> endnotes = new ArrayList<>();
        endnotes.add(endnote);
        
        // Use reflection to set endnotes in merged document
        java.lang.reflect.Field endnotesField = NiceXWPFDocument.class.getDeclaredField("endnotes");
        endnotesField.setAccessible(true);
        endnotesField.set(mergedDoc, endnotes);
        
        // Create iterator with merged document
        List<NiceXWPFDocument> docs = Collections.singletonList(mergedDoc);
        Iterator<NiceXWPFDocument> iterator = docs.iterator();
        
        // Create a run in a paragraph
        XWPFParagraph paragraph = mock(XWPFParagraph.class);
        when(paragraph.getCTP()).thenReturn(org.openxmlformats.schemas.wordprocessingml.x2006.main.CTP.Factory.newInstance());
        
        XWPFRun run = mock(XWPFRun.class);
        when(run.getParent()).thenReturn(paragraph);
        
        // Create XmlXWPFDocumentMerge instance
        XmlXWPFDocumentMerge merger = new XmlXWPFDocumentMerge();
        
        // Execute the entry point method
        merger.merge(sourceDoc, iterator, run);
        
        // The execution path should have invoked:
        // 1. merge() -> createMergeableStrings() -> createMergeableString() -> mergeEndnote()
        // 2. mergeEndnote() iterates through endnotes and calls getCTFtnEdn() on each
    }
}

