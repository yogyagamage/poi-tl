public class ConfigureBuilderbuidIterableLeft_PairofFikaTest {

    @Test
    public void testBuidIterableLeft() {
        ConfigureBuilder builder = new ConfigureBuilder();
        builder.buidIterableLeft('a');
    }

    // Minimal ConfigureBuilder class to make the test compile and run
    static class ConfigureBuilder {
        private Config config = new Config();
        
        public ConfigureBuilder buidIterableLeft(char c) {
            config.iterable = Pair.of(c, config.iterable.getRight());
            return this;
        }
    }
    
