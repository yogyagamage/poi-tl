        Mockito.when(style.isItalic()).thenReturn(Boolean.TRUE);
        Mockito.when(style.isBold()).thenReturn(Boolean.TRUE);
        Mockito.when(style.getFontSize()).thenReturn(12);
        Mockito.when(style.isStrike()).thenReturn(Boolean.TRUE);
        
        // Create UnderlinePatterns mock
        UnderlinePatterns underlinePatterns = Mockito.mock(UnderlinePatterns.class);
        Mockito.when(underlinePatterns.getValue()).thenReturn(1);
        Mockito.when(style.getUnderlinePatterns()).thenReturn(underlinePatterns);
        Mockito.when(style.getUnderlineColor()).thenReturn("auto");
        
        // Use reflection to call the private method
