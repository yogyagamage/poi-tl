public class HeaderFooterBodyContainerinsertNewTable_XWPFTablecreateRowFikaTest {

    @Test
    public void testInsertNewTablePathToCreateRow() throws Exception {
        XWPFDocument document = new XWPFDocument();
        XWPFHeader header = document.createHeader(XWPFHeader.FIRST);
        
        XWPFParagraph paragraph = header.createParagraph();
        XWPFRun run = paragraph.createRun();
        run.setText("Test");
        
        HeaderFooterBodyContainer container = new HeaderFooterBodyContainer(header);
        
        container.insertNewTable(run, 2, 3);
    }
    
    private static class HeaderFooterBodyContainer {
        private final Object headerFooter;
        
        public HeaderFooterBodyContainer(Object headerFooter) {
            this.headerFooter = headerFooter;
        }
        
        public XWPFTable insertNewTable(XWPFRun run, int row, int col) {
            XWPFParagraph paragraph = (XWPFParagraph) run.getParent();
            org.apache.xmlbeans.XmlCursor cursor = paragraph.getCTP().newCursor();
            XWPFTable table = insertNewTbl(cursor);
            
            java.util.List<XWPFTableRow> rows = table.getRows();
            for (int i = 0; i < rows.size(); i++) {
                table.removeRow(i);
            }
            for (int i = 0; i < row; i++) {
                XWPFTableRow tabRow = (table.getRow(i) == null) ? table.createRow() : table.getRow(i);
                for (int k = 0; k < col; k++) {
                    if (tabRow.getCell(k) == null) {
                        tabRow.createCell();
                    }
                }
            }
            return table;
        }
        
        private XWPFTable insertNewTbl(org.apache.xmlbeans.XmlCursor cursor) {
            try {
                java.lang.reflect.Method method = headerFooter.getClass().getMethod("insertNewTbl", org.apache.xmlbeans.XmlCursor.class);
                return (XWPFTable) method.invoke(headerFooter, cursor);
            } catch (Exception e) {
                throw new RuntimeException(e);
            }
        }
    }
    
    private static class XWPFTableRow {
        private final XWPFTable table;
        private final java.util.List<Object> cells = new java.util.ArrayList<>();
        
        public XWPFTableRow(XWPFTable table) {
            this.table = table;
        }
        
        public Object getCell(int index) {
            return index < cells.size() ? cells.get(index) : null;
        }
        
        public Object createCell() {
            Object cell = new Object();
            cells.add(cell);
            return cell;
        }
    }
    
    private static class XWPFTable {
        private final java.util.List<XWPFTableRow> rows = new java.util.ArrayList<>();
        
        public java.util.List<XWPFTableRow> getRows() {
            return new java.util.ArrayList<>(rows);
        }
        
        public void removeRow(int index) {
            if (index < rows.size()) {
                rows.remove(index);
            }
        }
        
        public XWPFTableRow getRow(int index) {
            return index < rows.size() ? rows.get(index) : null;
        }
        
        public XWPFTableRow createRow() {
            XWPFTableRow row = new XWPFTableRow(this);
            rows.add(row);
            return row;
        }
    }
}

