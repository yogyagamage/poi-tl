    @Test
    public void testDoRenderToPlotToUnsetNumLit() throws Exception {
        // Create minimal chart with required structure
        XWPFDocument doc = new XWPFDocument();
        XWPFChart chart = doc.createChart();
        
        // Create chart data that will trigger the path
        XDDFScatterChartData scatterData = (XDDFScatterChartData) chart.createData(
            ChartTypes.SCATTER, null, null
        );
        
        // Create categories and values
        Double[] categories = new Double[]{1.0, 2.0, 3.0};
        Double[] values = new Double[]{4.0, 5.0, 6.0};
        
        XDDFDataSource<Double> catSource = XDDFDataSourcesFactory.fromArray(categories);
        XDDFNumericalDataSource<Double> valSource = XDDFDataSourcesFactory.fromArray(values);
        
        // Add series - this creates the underlying CTAxDataSource
        scatterData.addSeries(catSource, valSource);
        
        // Get the chart series list
        List<XDDFChartData> chartSeries = new ArrayList<>();
        chartSeries.add(scatterData);
        
        // Use reflection to set chart series since getChartSeries() returns empty list
        Field chartSeriesField = XWPFChart.class.getDeclaredField("series");
        chartSeriesField.setAccessible(true);
        chartSeriesField.set(chart, chartSeries);
        
        // Create template with chart
        ChartTemplate chartTemplate = Mockito.mock(ChartTemplate.class);
        Mockito.when(chartTemplate.getChart()).thenReturn(chart);
        
        // Create render data with categories and series
        ChartMultiSeriesRenderData renderData = ChartMultiSeriesRenderData.builder()
            .categories(new String[]{"Cat1", "Cat2", "Cat3"})
            .addSeries(SeriesRenderData.builder("Series1", new Double[]{1.0, 2.0, 3.0}).build())
            .build();
        
        // Create template
        XWPFTemplate template = Mockito.mock(XWPFTemplate.class);
        
        // Create policy instance
        MultiSeriesChartTemplateRenderPolicy policy = new MultiSeriesChartTemplateRenderPolicy();
        
        // Execute the entry point - this should traverse through plot() to unsetNumLit()
        policy.doRender(chartTemplate, renderData, template);
        
        // Clean up
        doc.close();
    }
}

