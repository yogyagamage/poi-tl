            }
            // fix github issue 499
            CTStyle ctStyle = xwpfStyle.getCTStyle();
            if ((ctStyle.isSetDefault() && POIXMLUnits.parseOnOff(ctStyle.xgetDefault())) && (ctStyle.getType() == STStyleType.PARAGRAPH)) {
