protected Map<String, String> mergeStyles(NiceXWPFDocument source, NiceXWPFDocument merged) {
    Map<String, String> styleIdsMap = new HashMap<String, String>();
    XWPFStyles styles = source.getStyles();
    if (null == styles) {
