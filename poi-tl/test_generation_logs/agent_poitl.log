        Mockito.when(chart.getWorkbook()).thenReturn(workbook);
        Mockito.when(chart.getSheetTitle(Mockito.anyString(), Mockito.anyInt())).thenReturn("Sheet1");
        
        // Create real chart series list with at least one XDDFChartData
