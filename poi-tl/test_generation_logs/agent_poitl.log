package com.deepoove.poi.xwpf;

import org.apache.poi.xwpf.usermodel.XWPFTable;
import org.apache.poi.xwpf.usermodel.XWPFTableCell;
import org.apache.poi.xwpf.usermodel.XWPFTableRow;
import org.apache.poi.xwpf.usermodel.ICell;
import org.apache.poi.xwpf.usermodel.XWPFSDTCell;
import org.junit.jupiter.api.Test;
import java.util.List;
import java.util.ArrayList;

public class XWPFStructuredDocumentTagContentappendTable_XWPFTableCellgetTextRecursivelyFikaTest {

    @Test
    public void testAppendTableInvokesGetTextRecursively() throws Exception {
        XWPFTable table = createTableWithXWPFTableCell();
        StringBuilder text = new StringBuilder();
        
        appendTable(table, text);
    }
    
    private void appendTable(XWPFTable table, StringBuilder text) {
        for (XWPFTableRow row : table.getRows()) {
            List<ICell> cells = row.getTableICells();
            for (int i = 0; i < cells.size(); i++) {
                ICell cell = cells.get(i);
                if (cell instanceof XWPFTableCell) {
                    text.append(((XWPFTableCell) (cell)).getTextRecursively());
                } else if (cell instanceof XWPFSDTCell) {
                    text.append(((XWPFSDTCell) (cell)).getContent().getText());
                }
                if (i < (cells.size() - 1)) {
                    text.append("	");
                }
            }
            text.append('\n');
        }
    }
    
    private XWPFTable createTableWithXWPFTableCell() {
        XWPFTable table = new XWPFTable(null, null);
        XWPFTableRow row = new XWPFTableRow(null, table);
        List<ICell> cells = new ArrayList<>();
        
        XWPFTableCell cell = new XWPFTableCell(null, row, null);
        cells.add(cell);
        
        row.setTableICells(cells);
        table.addRow(row);
        
        return table;
    }
}

