package com.deepoove.poi.xwpf;

import org.apache.poi.xwpf.usermodel.XWPFParagraph;
import org.apache.poi.xwpf.usermodel.XWPFRun;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.util.*;

import static org.mockito.Mockito.*;

public class XmlXWPFDocumentMergemergeFootnote_XWPFFootnotegetCTFtnEdnFikaTest {

    @Test
    public void testMergeFootnoteGetCTFtnEdn() throws Exception {
        // Create source document with minimal content
        NiceXWPFDocument sourceDoc = new NiceXWPFDocument();
        
        // Create merged document with a footnote
        byte[] docBytes = createMinimalDocxWithFootnote();
        NiceXWPFDocument mergedDoc = new NiceXWPFDocument(new ByteArrayInputStream(docBytes));
        
        // Create iterator with the merged document
        List<NiceXWPFDocument> docs = new ArrayList<>();
        docs.add(mergedDoc);
        Iterator<NiceXWPFDocument> iterator = docs.iterator();
        
        // Create a mock run in a paragraph
        XWPFParagraph mockParagraph = mock(XWPFParagraph.class);
        XWPFRun mockRun = mock(XWPFRun.class);
        when(mockRun.getParent()).thenReturn(mockParagraph);
        
        // Create the merger and execute the merge
        XmlXWPFDocumentMerge merger = new XmlXWPFDocumentMerge();
        merger.merge(sourceDoc, iterator, mockRun);
        
        // The execution should have gone through:
        // 1. merge() -> createMergeableStrings() -> createMergeableString() -> mergeFootnote()
        // 2. mergeFootnote() iterates through footnotes and calls getCTFtnEdn()
    }
    
    private byte[] createMinimalDocxWithFootnote() throws IOException {
        // Create a minimal DOCX with a footnote
        NiceXWPFDocument doc = new NiceXWPFDocument();
        
        // Create a paragraph with text
        XWPFParagraph paragraph = doc.createParagraph();
        XWPFRun run = paragraph.createRun();
        run.setText("Test text");
        
        // Add a footnote
        doc.createFootnote().createParagraph().createRun().setText("Footnote text");
        
        // Write to byte array
        java.io.ByteArrayOutputStream baos = new java.io.ByteArrayOutputStream();
        doc.write(baos);
        doc.close();
        
        return baos.toByteArray();
    }
}

