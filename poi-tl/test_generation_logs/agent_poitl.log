import org.apache.poi.xwpf.usermodel.XWPFChart;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.lang.reflect.Field;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

public class MultiSeriesChartTemplateRenderPolicy_AbstractChartTemplateRenderPolicyplot_CTAxDataSourceunsetNumRefFikaTest {

    @Test
    public void test() throws Exception {
        // Create the policy instance
        MultiSeriesChartTemplateRenderPolicy policy = new MultiSeriesChartTemplateRenderPolicy();
        
        // Create mock template
        XWPFTemplate template = Mockito.mock(XWPFTemplate.class);
        
        // Create mock chart template
        ChartTemplate chartTemplate = Mockito.mock(ChartTemplate.class);
        
        // Create real XWPFChart with workbook
        XWPFChart chart = Mockito.mock(XWPFChart.class);
        Mockito.when(chartTemplate.getChart()).thenReturn(chart);
        
        // Create mock workbook and sheet
        org.apache.poi.xssf.usermodel.XSSFWorkbook workbook = new org.apache.poi.xssf.usermodel.XSSFWorkbook();
        XSSFSheet sheet = workbook.createSheet();
        Mockito.when(chart.getWorkbook()).thenReturn(workbook);
        
        // Create chart series list with at least one XDDFChartData
        List<XDDFChartData> chartSeries = new ArrayList<>();
        
        // Create a real XDDFLineChartData
        XDDFLineChartData lineChartData = (XDDFLineChartData) chart.createData(
            ChartTypes.LINE, null, null
        );
        
        // Create categories and values data sources
        String[] categories = new String[]{"Cat1", "Cat2", "Cat3"};
        Double[] values = new Double[]{1.0, 2.0, 3.0};
        
        XDDFDataSource<String> catDataSource = XDDFDataSourcesFactory.fromArray(categories);
        XDDFNumericalDataSource<Double> valDataSource = XDDFDataSourcesFactory.fromArray(values);
        
        // Add a series to the chart data
        XDDFLineChartData.Series series = (XDDFLineChartData.Series) lineChartData.addSeries(catDataSource, valDataSource);
        series.setTitle("Test Series", chart.setSheetTitle("Test Series", 1));
        
        chartSeries.add(lineChartData);
        Mockito.when(chart.getChartSeries()).thenReturn(chartSeries);
        
        // Create render data
        ChartMultiSeriesRenderData renderData = new ChartMultiSeriesRenderData();
        
        // Set categories
        Field categoriesField = ChartMultiSeriesRenderData.class.getDeclaredField("categories");
        categoriesField.setAccessible(true);
        categoriesField.set(renderData, categories);
        
        // Create series data
        SeriesRenderData seriesData = new SeriesRenderData();
        seriesData.setName("Test Series");
        seriesData.setValues(values);
        
        // Set series datas
        Field seriesDatasField = ChartMultiSeriesRenderData.class.getDeclaredField("seriesDatas");
        seriesDatasField.setAccessible(true);
        seriesDatasField.set(renderData, Arrays.asList(seriesData));
        
        // Invoke the entry point method
        policy.doRender(chartTemplate, renderData, template);
    }
}

