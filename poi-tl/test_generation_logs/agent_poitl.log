package com.deepoove.poi.xwpf;

import org.apache.poi.xwpf.usermodel.XWPFDocument;
import org.apache.poi.xwpf.usermodel.XWPFParagraph;
import org.apache.poi.xwpf.usermodel.XWPFRun;
import org.apache.poi.xwpf.usermodel.XWPFTable;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.io.ByteArrayOutputStream;

public class CommentBodyContainerinsertNewTable_XWPFTablecreateRowFikaTest {

    @Test
    public void testInsertNewTableCallsCreateRow() throws Exception {
        // Create a real XWPFDocument to get real XWPF objects
        XWPFDocument document = new XWPFDocument();
        
        // Create a real paragraph and run
        XWPFParagraph paragraph = document.createParagraph();
        XWPFRun run = paragraph.createRun();
        run.setText("test");
        
        // Create a mock CommentBodyContainer that delegates to a real implementation
        // We need to find a concrete implementation of CommentBodyContainer
        // Since we can't instantiate abstract class, we'll use XWPFHeader which extends CommentBodyContainer
        ByteArrayOutputStream out = new ByteArrayOutputStream();
        document.write(out);
        document.close();
        
        byte[] documentBytes = out.toByteArray();
        XWPFDocument documentForHeader = new XWPFDocument(new ByteArrayInputStream(documentBytes));
        
        // XWPFHeader is a concrete implementation of CommentBodyContainer
        // Create a header to get a CommentBodyContainer instance
        org.apache.poi.xwpf.usermodel.XWPFHeader header = documentForHeader.createHeader(org.openxmlformats.schemas.wordprocessingml.x2006.main.STHdrFtr.DEFAULT);
        
        // Call the entry point method with parameters that will trigger createRow()
        // We need row > 0 to enter the loop and trigger createRow()
        header.insertNewTable(run, 2, 1);
        
        documentForHeader.close();
    }
}

