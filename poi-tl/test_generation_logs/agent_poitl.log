        // and ensure it has a numbering with existing abstract nums
        org.apache.poi.xwpf.usermodel.XWPFNumberingWrapper wrapper = 
            new org.apache.poi.xwpf.usermodel.XWPFNumberingWrapper(numbering);
        
        // Add some existing abstract nums to ensure getNextAbstractNumID() works
        when(numbering.getAbstractNum(BigInteger.valueOf(0))).thenReturn(null);
