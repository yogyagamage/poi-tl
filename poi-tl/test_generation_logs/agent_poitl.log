                if (null != newId) {
                    ctStyle.getBasedOn().setVal(newId);
                }
            }
            styles.addStyle(xwpfStyle);
        }
        if (null != defaultParaStyleId) {
            final String dpid = defaultParaStyleId;
            merged.getParagraphs().stream().filter(p -> null == p.getStyle()).forEach(p -> p.setStyle(dpid));
        }
