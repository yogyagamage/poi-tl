                        StyleUtils.styleRun(insertNewRun, xwpfRun);
                        insertNewRun.setText(((CTText) (obj)).getStringValue());
                    }
                }
                runBodyContext.removeRun(i);
            }
        }
    }
    this.runs = runBodyContext.getRuns();
}

