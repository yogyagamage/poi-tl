    } else if (object instanceof CTSimpleField) {
        return new XWPFFieldRun(((CTSimpleField) (object)), ((CTSimpleField) (object)).getRArray(0), p);
    } else {
        return new XWPFRun(((CTR) (object)), p);
    }
}

