import org.apache.poi.xwpf.usermodel.XWPFTableRow;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.util.*;

class HelperapplyMergeRule_XWPFTableRowgetTableCellsFikaTest {

    @Test
    void testApplyMergeRule() throws Exception {
        // Create a real table with at least one row
        XWPFTable table = Mockito.mock(XWPFTable.class);
        XWPFTableRow row = Mockito.mock(XWPFTableRow.class);
        
        // Setup table to return rows
        List<XWPFTableRow> rows = new ArrayList<>();
        rows.add(row);
        Mockito.when(table.getRows()).thenReturn(rows);
        Mockito.when(table.getRow(0)).thenReturn(row);
        
        // Setup row to return cells
        List<org.apache.poi.xwpf.usermodel.XWPFTableCell> cells = new ArrayList<>();
        Mockito.when(row.getTableCells()).thenReturn(cells);
        
        // Create merge rule with at least one mapping
        MergeCellRule mergeRule = new MergeCellRule();
        Map<Grid, Grid> mapping = new HashMap<>();
        mapping.put(new Grid(0, 0), new Grid(0, 1));
        mergeRule.setMapping(mapping);
        
        // Invoke the method under test
        applyMergeRule(table, mergeRule);
    }
    
    // Helper classes to make the test compile
    private static class MergeCellRule {
        private Map<Grid, Grid> mapping = new HashMap<>();
        
        public void setMapping(Map<Grid, Grid> mapping) {
            this.mapping = mapping;
        }
        
        public Iterator<Map.Entry<Grid, Grid>> mappingIterator() {
            return mapping.entrySet().iterator();
        }
    }
    
    private static class Grid {
        private final int i;
        private final int j;
        
        public Grid(int i, int j) {
            this.i = i;
            this.j = j;
        }
        
        public int getI() { return i; }
        public int getJ() { return j; }
    }
    
    // TableTools stub
    private static class TableTools {
        public static int obtainRowSize(XWPFTable table) { return 1; }
        public static int obtainColumnSize(XWPFTable table) { return 2; }
        public static void mergeCellsVertically(XWPFTable table, int col, int startRow, int endRow) {}
        public static void mergeCellsHorizontalWithoutRemove(XWPFTable table, int row, int startCol, int endCol) {}
    }
    
    // The method under test (copied exactly from the source)
    private static void applyMergeRule(XWPFTable table, MergeCellRule mergeRule) {
        if (null == mergeRule) {
            return;
        }
        byte[][] markRemovedCell = new byte[TableTools.obtainRowSize(table)][TableTools.obtainColumnSize(table)];
        Iterator<Map.Entry<Grid, Grid>> iterator = mergeRule.mappingIterator();
        while (iterator.hasNext()) {
            Map.Entry<Grid, Grid> next = iterator.next();
            Grid key = next.getKey();
            Grid value = next.getValue();
            int startI = (key.getI() > value.getI()) ? value.getI() : key.getI();
            int startJ = (key.getJ() > value.getJ()) ? value.getJ() : key.getJ();
            int endI = (key.getI() > value.getI()) ? key.getI() : value.getI();
            int endJ = (key.getJ() > value.getJ()) ? key.getJ() : value.getJ();
            // merge(VMerge mark) vertical
            if (startI != endI) {
                for (int j = startJ; j <= endJ; j++) {
                    TableTools.mergeCellsVertically(table, j, startI, endI);
                }
            }
            // merge horizontal cells without remove cells
            if (startJ != endJ) {
                for (int i = startI; i <= endI; i++) {
                    TableTools.mergeCellsHorizontalWithoutRemove(table, i, startJ, endJ);
                    for (int removedCol = startJ + 1; removedCol <= endJ; removedCol++) {
                        markRemovedCell[i][removedCol] = 1;
                    }
                }
            }
        } 
        // remove marked cell safely
        for (int i = 0; i < markRemovedCell.length; i++) {
            for (int j = markRemovedCell[i].length - 1; j >= 0; j--) {
                if (markRemovedCell[i][j] >= 1) {
                    table.getRow(i).removeCell(j);
                    if (table.getRow(i).getTableCells().size() != table.getRow(i).getCtRow().sizeOfTcArray()) {
                        table.getRow(i).getCtRow().removeTc(j);
                    }
                }
            }
        }
    }
}

