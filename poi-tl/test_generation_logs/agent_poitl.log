import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import static org.mockito.Mockito.when;

public class MultiSeriesChartTemplateRenderPolicy_AbstractChartTemplateRenderPolicycreateStringDataSource_CellRangeAddressmethodFikaTest {

    @Test
    public void testCreateStringDataSource() throws Exception {
        XWPFChart chart = Mockito.mock(XWPFChart.class);
        String[] categories = new String[]{"A", "B", "C"};
        int col = 1;
        
        when(chart.formatRange(Mockito.any())).thenReturn("Sheet1!$B$2:$B$4");
        
        XDDFDataSource<?> result = createStringDataSource(chart, categories, col);
    }

    protected XDDFDataSource<?> createStringDataSource(XWPFChart chart, String[] categories, int col) {
        return org.apache.poi.xddf.usermodel.chart.XDDFDataSourcesFactory.fromArray(
            categories, 
            chart.formatRange(new org.apache.poi.ss.util.CellRangeAddress(1, categories.length, col, col)), 
            col
        );
    }
}

