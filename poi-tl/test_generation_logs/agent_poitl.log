public XWPFRun insertNewRun(int pos) {
    if (pos == runs.size()) {
        return createRun();
    }
    // PATH: Test should invoke the next XWPFStructuredDocumentTagContent.insertNewProvidedRun(...) [step in execution path]
    return insertNewProvidedRun(pos, newCursor -> {
