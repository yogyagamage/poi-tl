package com.deepoove.poi.policy;

import org.apache.poi.xwpf.usermodel.XWPFParagraph;
import org.apache.poi.xwpf.usermodel.XWPFRun;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import com.deepoove.poi.xwpf.XWPFParagraphWrapper;

import static org.mockito.Mockito.when;

public class HelpercreateBookmark_CTBookmarksetNameFikaTest {

    @Test
    public void testCreateBookmark() throws Exception {
        XWPFRun textRun = Mockito.mock(XWPFRun.class);
        XWPFParagraph paragraph = Mockito.mock(XWPFParagraph.class);
        XWPFParagraphWrapper wrapper = Mockito.mock(XWPFParagraphWrapper.class);
        
        when(textRun.getParent()).thenReturn(paragraph);
        
        org.openxmlformats.schemas.wordprocessingml.x2006.main.CTBookmark ctBookmark = 
            org.openxmlformats.schemas.wordprocessingml.x2006.main.CTBookmark.Factory.newInstance();
        
        when(wrapper.insertNewBookmark(textRun)).thenReturn(ctBookmark);
        
        java.lang.reflect.Method method = getClass().getDeclaredMethod(
            "createBookmark", 
            XWPFRun.class, 
            String.class, 
            XWPFParagraphWrapper.class
        );
        method.setAccessible(true);
        method.invoke(null, textRun, "testBookmark", wrapper);
    }
    
    private static void createBookmark(XWPFRun textRun, String name, XWPFParagraphWrapper wrapper) {
        CTBookmark bookmarkStart = wrapper.insertNewBookmark(textRun);
        bookmarkStart.setName(name);
    }
    
    private static class CTBookmark {
        private String name;
        
        public void setName(String name) {
            this.name = name;
        }
    }
}

