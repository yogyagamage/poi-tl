import static org.mockito.Mockito.*;

public class SingleSeriesChartTemplateRenderPolicy_AbstractChartTemplateRenderPolicyplot_CTAxDataSourceunsetNumRefFikaTest {

    @Test
    public void testDoRenderToUnsetNumRef() throws Exception {
        // Create mocks for dependencies
        ChartTemplate chartTemplate = mock(ChartTemplate.class);
        ChartSingleSeriesRenderData chartData = mock(ChartSingleSeriesRenderData.class);
        XWPFTemplate xwpfTemplate = mock(XWPFTemplate.class);
        XWPFChart xwpfChart = mock(XWPFChart.class);
        XDDFChartData xddfChartData = mock(XDDFChartData.class);
        XDDFChartData.Series series = mock(XDDFChartData.Series.class);
        XDDFDataSource<?> categoryDataSource = mock(XDDFDataSource.class);
        XDDFNumericalDataSource<?> valuesDataSource = mock(XDDFNumericalDataSource.class);
        SeriesRenderData seriesRenderData = mock(SeriesRenderData.class);
        XSSFSheet sheet = mock(XSSFSheet.class);
        
        // Setup chartTemplate to return chart
        when(chartTemplate.getChart()).thenReturn(xwpfChart);
        
        // Setup chartData to return series data and categories
        when(chartData.getSeriesData()).thenReturn(seriesRenderData);
        when(chartData.getCategories()).thenReturn(Arrays.asList("Cat1", "Cat2"));
        when(chartData.getChartTitle()).thenReturn("Test Chart");
        when(chartData.getxAxisTitle()).thenReturn("X Axis");
        when(chartData.getyAxisTitle()).thenReturn("Y Axis");
        
        // Setup seriesRenderData
        when(seriesRenderData.getValues()).thenReturn(Arrays.asList(10.0, 20.0));
        when(seriesRenderData.getName()).thenReturn("Series1");
        
        // Setup xwpfChart to return workbook and sheet
        org.apache.poi.xssf.usermodel.XSSFWorkbook workbook = mock(org.apache.poi.xssf.usermodel.XSSFWorkbook.class);
        when(xwpfChart.getWorkbook()).thenReturn(workbook);
        when(workbook.getSheetAt(0)).thenReturn(sheet);
        when(xwpfChart.setSheetTitle(anyString(), anyInt())).thenReturn(1);
        
        // Setup xddfChartData to return series
        when(xddfChartData.getSeries()).thenReturn(Arrays.asList(series));
        
        // Setup series to return non-numeric category data
        when(series.getCategoryData()).thenReturn(categoryDataSource);
        when(categoryDataSource.isNumeric()).thenReturn(false);
        
        // Setup series to return values data
        when(series.getValuesData()).thenReturn(valuesDataSource);
        
        // Create instance of class under test
        SingleSeriesChartTemplateRenderPolicy policy = new SingleSeriesChartTemplateRenderPolicy();
        
        // Use reflection to inject mocked chart series into ChartUtils
        Method getChartSeriesMethod = Class.forName("com.deepoove.poi.util.ChartUtils")
                .getDeclaredMethod("getChartSeries", XWPFChart.class);
        getChartSeriesMethod.setAccessible(true);
        
        // Create a spy to intercept the getChartSeries call
        XWPFChart chartSpy = spy(xwpfChart);
        doReturn(Arrays.asList(xddfChartData)).when(chartSpy).getChartSeries();
        
        // Replace the original chart with our spy
        when(chartTemplate.getChart()).thenReturn(chartSpy);
        
        // Execute the entry point method
        policy.doRender(chartTemplate, chartData, xwpfTemplate);
    }
}

