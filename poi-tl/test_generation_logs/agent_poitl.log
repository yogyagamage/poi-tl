class MultiSeriesChartTemplateRenderPolicy_AbstractChartTemplateRenderPolicysetCTTitle_CTTxunsetStrRefFikaTest {

    @Test
    void testSetCTTitleInvokesUnsetStrRef() throws Exception {
        CTTx mockTx = Mockito.mock(CTTx.class);
        Mockito.when(mockTx.isSetStrRef()).thenReturn(true);
        Mockito.when(mockTx.isSetRich()).thenReturn(false);
        
        CTTextBody mockBody = Mockito.mock(CTTextBody.class);
        Mockito.when(mockTx.getRich()).thenReturn(mockBody);
        Mockito.when(mockBody.sizeOfPArray()).thenReturn(1);
        
        CTTextParagraph mockParagraph = Mockito.mock(CTTextParagraph.class);
        Mockito.when(mockBody.getPArray(0)).thenReturn(mockParagraph);
        Mockito.when(mockParagraph.sizeOfRArray()).thenReturn(1);
        
        CTRegularTextRun mockTextRun = Mockito.mock(CTRegularTextRun.class);
        Mockito.when(mockParagraph.getRArray(0)).thenReturn(mockTextRun);
        
        CTTitle mockTitle = Mockito.mock(CTTitle.class);
        Mockito.when(mockTitle.isSetTx()).thenReturn(true);
        Mockito.when(mockTitle.getTx()).thenReturn(mockTx);
        
        MultiSeriesChartTemplateRenderPolicy policy = new MultiSeriesChartTemplateRenderPolicy();
        
        java.lang.reflect.Method method = MultiSeriesChartTemplateRenderPolicy.class
            .getDeclaredMethod("setCTTitle", CTTitle.class, String.class);
        method.setAccessible(true);
        method.invoke(policy, mockTitle, "Test Title");
    }
    
    private static class MultiSeriesChartTemplateRenderPolicy {
        private boolean setCTTitle(CTTitle ctTitle, String title) {
            boolean isSet = false;
            if (null != ctTitle) {
                if (!ctTitle.isSetTx()) {
                    ctTitle.addNewTx();
                }
                CTTx tx = ctTitle.getTx();
                if (tx.isSetStrRef()) {
                    tx.unsetStrRef();
                }
                if (!tx.isSetRich()) {
                    tx.addNewRich();
                }
                CTTextBody body = tx.getRich();
                if (body.sizeOfPArray() > 0) {
                    for (int i = body.sizeOfPArray() - 1; i > 0; i--) {
                        body.removeP(i);
                    }
                    CTTextParagraph pArray = body.getPArray(0);
                    if (pArray.sizeOfRArray() > 0) {
                        for (int i = pArray.sizeOfRArray() - 1; i > 0; i--) {
                            pArray.removeR(i);
                        }
                        CTRegularTextRun rArray = pArray.getRArray(0);
                        rArray.setT(title);
                        isSet = true;
                    }
                }
            }
            return isSet;
        }
    }
}

