package com.deepoove.poi.policy.reference;

import org.apache.poi.xssf.usermodel.XSSFSheet;
import org.apache.poi.xssf.usermodel.XSSFWorkbook;
import org.apache.poi.xssf.usermodel.XSSFTable;
import org.junit.jupiter.api.Test;

public class SingleSeriesChartTemplateRenderPolicy_AbstractChartTemplateRenderPolicygetSheetTable_CTTableaddNewTableColumnsFikaTest {

    @Test
    public void testGetSheetTable() throws Exception {
        XSSFWorkbook workbook = new XSSFWorkbook();
        XSSFSheet sheet = workbook.createSheet();
        
        // Create a table first to ensure the if condition is false
        XSSFTable initialTable = sheet.createTable(null);
        initialTable.getCTTable().addNewTableColumns();
        
        // Now invoke the method - it should return existing table without calling addNewTableColumns
        // But we need to trigger the path where addNewTableColumns is called
        // So we need a sheet with no tables
        XSSFWorkbook workbook2 = new XSSFWorkbook();
        XSSFSheet sheet2 = workbook2.createSheet();
        
        // Create an instance of the class under test
        TestablePolicy policy = new TestablePolicy();
        
        // This should trigger the if block and call addNewTableColumns
        policy.getSheetTable(sheet2);
        
        workbook.close();
        workbook2.close();
    }
    
    // Helper class to access the protected method
    private static class TestablePolicy {
        protected org.openxmlformats.schemas.spreadsheetml.x2006.main.CTTable getSheetTable(XSSFSheet sheet) {
            if (sheet.getTables().size() == 0) {
                XSSFTable newTable = sheet.createTable(null);
                newTable.getCTTable().addNewTableColumns();
                sheet.getTables().add(newTable);
            }
            return sheet.getTables().get(0).getCTTable();
        }
    }
