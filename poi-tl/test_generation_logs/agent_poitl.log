import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import static org.mockito.Mockito.when;

public class SingleSeriesChartTemplateRenderPolicy_AbstractChartTemplateRenderPolicycreateStringDataSource_CellRangeAddressmethodFikaTest {

    @Test
    public void testCreateStringDataSource() throws Exception {
        XWPFChart chart = Mockito.mock(XWPFChart.class);
        String[] categories = new String[]{"A", "B", "C"};
        int col = 0;
        
        when(chart.formatRange(Mockito.any())).thenReturn("Sheet1!$A$1:$A$3");
        
        XDDFDataSource<?> result = createStringDataSource(chart, categories, col);
    }

    private XDDFDataSource<?> createStringDataSource(XWPFChart chart, String[] categories, int col) {
        final int FIRST_ROW = 0;
        return org.apache.poi.xddf.usermodel.chart.XDDFDataSourcesFactory.fromArray(
            categories, 
            chart.formatRange(new org.apache.poi.ss.util.CellRangeAddress(FIRST_ROW, categories.length, col, col)), 
            col
        );
    }
}

