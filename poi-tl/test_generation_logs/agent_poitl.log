package com.deepoove.poi.xwpf;

import org.apache.poi.xwpf.usermodel.XWPFParagraph;
import org.apache.poi.xwpf.usermodel.XWPFRun;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.math.BigInteger;
import java.util.*;

import static org.mockito.Mockito.*;

class XmlXWPFDocumentMergemergeFootnote_CTFtnEdnsetIdFikaTest {

    @Test
    void testMergePathToSetId() throws Exception {
        // Create source document with footnotes
        NiceXWPFDocument sourceDoc = new NiceXWPFDocument();
        
        // Create merged document with a footnote
        byte[] docBytes = getDocumentWithFootnote();
        NiceXWPFDocument mergedDoc = new NiceXWPFDocument(new ByteArrayInputStream(docBytes));
        
        // Create iterator with the merged document
        List<NiceXWPFDocument> docs = new ArrayList<>();
        docs.add(mergedDoc);
        Iterator<NiceXWPFDocument> iterator = docs.iterator();
        
        // Create a run in a paragraph
        XWPFParagraph paragraph = mock(XWPFParagraph.class);
        XWPFRun run = mock(XWPFRun.class);
        when(run.getParent()).thenReturn(paragraph);
        
        // Create XmlXWPFDocumentMerge instance
        XmlXWPFDocumentMerge merger = new XmlXWPFDocumentMerge();
        
        // Execute the entry point method
        merger.merge(sourceDoc, iterator, run);
    }
    
    private byte[] getDocumentWithFootnote() throws IOException {
        // Create a minimal Word document with a footnote
        NiceXWPFDocument doc = new NiceXWPFDocument();
        
        // Add a paragraph with text
        XWPFParagraph paragraph = doc.createParagraph();
        XWPFRun run = paragraph.createRun();
        run.setText("Test text");
        
        // Add a footnote
        XWPFFootnote footnote = doc.createFootnote();
        footnote.getCTFtnEdn().setId(BigInteger.ONE);
        XWPFParagraph footnotePara = footnote.getParagraphs().get(0);
        XWPFRun footnoteRun = footnotePara.createRun();
        footnoteRun.setText("Footnote text");
        
        // Convert to bytes
        java.io.ByteArrayOutputStream baos = new java.io.ByteArrayOutputStream();
        doc.write(baos);
        doc.close();
        return baos.toByteArray();
    }
}

