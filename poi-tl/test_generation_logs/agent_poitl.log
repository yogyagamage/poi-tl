import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.util.Arrays;
import java.util.Collections;
import java.util.List;

public class MultipleColumnTableRenderPolicyrender_XWPFTableCellsetWidthFikaTest {

    @Test
    public void testRender() throws Exception {
        // Create a real table structure
        XWPFDocument document = new XWPFDocument();
        XWPFTable table = document.createTable(2, 3);
        
        // Get a real cell from the table
        XWPFTableRow row = table.getRow(0);
        XWPFTableCell tagCell = row.getCell(0);
        
        // Create a paragraph and run inside the cell
        XWPFParagraph paragraph = tagCell.addParagraph();
        XWPFRun run = paragraph.createRun();
        run.setText("{{#test}}");
        
        // Create RunTemplate with the real run
        RunTemplate runTemplate = Mockito.mock(RunTemplate.class);
        Mockito.when(runTemplate.getRun()).thenReturn(run);
        Mockito.when(runTemplate.getSource()).thenReturn("{{#test}}");
        
        // Create XWPFTemplate with minimal configuration
        Configure config = Configure.builder().build();
        XWPFTemplate xwpfTemplate = Mockito.mock(XWPFTemplate.class);
        Mockito.when(xwpfTemplate.getConfig()).thenReturn(config);
        
        // Create test data that will trigger the loop
        List<String> testData = Arrays.asList("item1", "item2");
        
        // Create the policy instance
        MultipleColumnTableRenderPolicy policy = new MultipleColumnTableRenderPolicy();
        
        // Execute the entry point method
        policy.render(runTemplate, testData, xwpfTemplate);
    }
}

