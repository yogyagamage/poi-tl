package com.deepoove.poi.xwpf;

import org.apache.poi.xwpf.usermodel.XWPFDocument;
import org.apache.poi.xwpf.usermodel.XWPFParagraph;
import org.apache.poi.xwpf.usermodel.XWPFRun;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.io.IOException;
import java.util.Arrays;
import java.util.Iterator;
import java.util.List;

public class XmlXWPFDocumentMergemergeFootnote_XWPFFootnotesaddFootnoteFikaTest {

    @Test
    public void testMergeFootnotePath() throws Exception {
        // Create source document with minimal content to have a body
        XWPFDocument sourceDoc = new XWPFDocument();
        sourceDoc.createParagraph().createRun().setText("Source");
        
        // Create merged document with a footnote to trigger the path
        XWPFDocument mergedDoc = new XWPFDocument();
        XWPFParagraph mergedPara = mergedDoc.createParagraph();
        XWPFRun mergedRun = mergedPara.createRun();
        mergedRun.setText("Merged");
        mergedDoc.createFootnote().createParagraph().createRun().setText("Footnote text");
        
        // Create NiceXWPFDocument wrappers
        NiceXWPFDocument sourceNiceDoc = new NiceXWPFDocument(sourceDoc);
        NiceXWPFDocument mergedNiceDoc = new NiceXWPFDocument(mergedDoc);
        
        // Create iterator with the merged document
        List<NiceXWPFDocument> docsList = Arrays.asList(mergedNiceDoc);
        Iterator<NiceXWPFDocument> iterator = docsList.iterator();
        
        // Get a run from source document to pass as parameter
        XWPFRun sourceRun = sourceDoc.getParagraphs().get(0).getRuns().get(0);
        
        // Create instance of class under test
        XmlXWPFDocumentMerge mergeInstance = new XmlXWPFDocumentMerge();
        
        // Execute the entry point method - this should traverse the entire path
        // and eventually call XWPFFootnotes.addFootnote()
        mergeInstance.merge(sourceNiceDoc, iterator, sourceRun);
        
        // Clean up
        sourceDoc.close();
        mergedDoc.close();
    }
}

