package com.deepoove.poi.policy;

import com.deepoove.poi.data.NumberingItemRenderData;
import com.deepoove.poi.data.NumberingRenderData;
import com.deepoove.poi.data.ParagraphRenderData;
import com.deepoove.poi.data.TextRenderData;
import com.deepoove.poi.data.style.Style;
import org.apache.poi.xwpf.usermodel.XWPFDocument;
import org.apache.poi.xwpf.usermodel.XWPFParagraph;
import org.apache.poi.xwpf.usermodel.XWPFRun;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.math.BigInteger;
import java.util.Arrays;
import java.util.Collections;

public class HelperrenderNumbering_XWPFParagraphsetNumIDFikaTest {

    @Test
    public void testRenderNumbering() throws Exception {
        XWPFDocument document = new XWPFDocument();
        XWPFParagraph paragraph = document.createParagraph();
        XWPFRun run = paragraph.createRun();
        
        NumberingItemRenderData item = new NumberingItemRenderData();
        item.setLevel(1);
        ParagraphRenderData paragraphData = new ParagraphRenderData();
        paragraphData.addText(new TextRenderData("Test"));
        item.setItem(paragraphData);
        
        NumberingRenderData data = new NumberingRenderData();
        data.setItems(Collections.singletonList(item));
        data.setFormats(Arrays.asList(
            com.deepoove.poi.data.NumberingFormat.DECIMAL,
            com.deepoove.poi.data.NumberingFormat.BULLET
        ));
        
        NumberingRenderPolicy.Helper.renderNumbering(run, data);
        
        document.close();
    }
}

