package com.deepoove.poi.policy.reference;

import com.deepoove.poi.XWPFTemplate;
import com.deepoove.poi.data.ChartSingleSeriesRenderData;
import com.deepoove.poi.data.SeriesRenderData;
import com.deepoove.poi.template.ChartTemplate;
import org.apache.poi.xddf.usermodel.chart.*;
import org.apache.poi.xwpf.usermodel.XWPFChart;
import org.apache.poi.xwpf.usermodel.XWPFDocument;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.io.ByteArrayInputStream;
import java.util.Arrays;
import java.util.Collections;

public class SingleSeriesChartTemplateRenderPolicydoRender_SeriesreplaceDataFikaTest {

    @Test
    public void testDoRender() throws Exception {
        // Create a real XWPFDocument with a chart
        XWPFDocument document = new XWPFDocument();
        XWPFChart chart = document.createChart();
        
        // Create real chart data
        XDDFChartData chartData = createRealChartData(chart);
        chart.plot(chartData);
        
        // Mock ChartTemplate to return the real chart
        ChartTemplate chartTemplate = Mockito.mock(ChartTemplate.class);
        Mockito.when(chartTemplate.getChart()).thenReturn(chart);
        
        // Create real render data
        ChartSingleSeriesRenderData renderData = new ChartSingleSeriesRenderData();
        renderData.setChartTitle("Test Chart");
        renderData.setxAxisTitle("X Axis");
        renderData.setyAxisTitle("Y Axis");
        renderData.setCategories(Arrays.asList("Cat1", "Cat2", "Cat3"));
        
        SeriesRenderData seriesData = new SeriesRenderData();
        seriesData.setName("Series1");
        seriesData.setValues(Arrays.asList(10.0, 20.0, 30.0));
        renderData.setSeriesData(seriesData);
        
        // Create a real XWPFTemplate with the document
        XWPFTemplate template = XWPFTemplate.create(new ByteArrayInputStream(new byte[0]));
        
        // Use reflection to set the internal document
        try {
            java.lang.reflect.Field field = template.getClass().getDeclaredField("document");
            field.setAccessible(true);
            field.set(template, document);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        
        // Create the policy instance and call the entry point
        SingleSeriesChartTemplateRenderPolicy policy = new SingleSeriesChartTemplateRenderPolicy();
        policy.doRender(chartTemplate, renderData, template);
    }
    
    private XDDFChartData createRealChartData(XWPFChart chart) {
        // Create a simple pie chart data structure
        XDDFDataSource<String> categories = XDDFDataSourcesFactory.fromArray(
            new String[]{"Category1", "Category2", "Category3"});
        XDDFNumericalDataSource<Double> values = XDDFDataSourcesFactory.fromArray(
            new Double[]{1.0, 2.0, 3.0});
        
        XDDFChartData data = chart.createData(ChartTypes.PIE, null, null);
        data.addSeries(categories, values);
        return data;
    }
}

