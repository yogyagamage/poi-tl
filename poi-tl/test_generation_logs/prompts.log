    if (null == tblBorders) {
        tblBorders = tblPr.addNewTblBorders();
    }
    BigInteger borderSize = BigInteger.valueOf(size);
    if (// PATH: Test should invoke the next CTTblBorders.isSetBottom(...) [step in execution path]
    !tblBorders.isSetBottom()) {
        tblBorders.addNewBottom();
