            } else if (cell instanceof XWPFSDTCell) {
                text.append(// PATH: Test should invoke the next XWPFSDTCell.getContent(...) [step in execution path]
                ((XWPFSDTCell) (cell)).getContent().getText());
            }
            if (i < (cells.size() - 1)) {
                text.append("	");
            }
        }
        text.append('
');
    }
}

